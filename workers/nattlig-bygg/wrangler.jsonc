// Separate Worker: only a cron trigger, no routes. The site itself stays an assets-only Worker (../../wrangler.jsonc).
{
  "name": "arnatveit-nattlig-bygg",
  "main": "index.js",
  "compatibility_date": "2026-09-25",
  // 01:00 UTC = 02:00 (winter) / 03:00 (summer) Norwegian time, just after midnight either way
  "triggers": { "crons": ["0 1 * * *"] },
  "workers_dev": false
}
