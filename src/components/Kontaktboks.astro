---
// Green contact box beside the page title ("Skriv til hele styret"). On phones: one full-width button.
import Icon from './Icon.astro';
import Epost from './Epost.astro';
const { tittel = 'Skriv til hele styret', epost, knappetekst = 'Send e-post' } = Astro.props;
---
{epost && (
  <aside class="kontaktboks">
    <div class="boks">
      <span class="tittel">{tittel}</span>
      <span class="adresse"><Epost adresse={epost} /></span>
      <a class="knapp" href={`mailto:${epost}`}><Icon name="Mail" size={16} />{knappetekst}</a>
    </div>
    <a class="mobil" href={`mailto:${epost}`}><Icon name="Mail" size={18} />{tittel}</a>
  </aside>
)}
<style>
  .boks { background: var(--accent); color: #fff; border-radius: 22px; padding: 26px 28px; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .tittel { font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-on); }
  .adresse { font-family: var(--serif); font-size: clamp(19px, 1.6vw, 22px); line-height: 1.25; }
  .knapp { display: inline-flex; align-items: center; gap: 8px; margin-top: 6px; background: #fff; color: var(--ink); border-radius: 999px; padding: 11px 20px; font-weight: 600; font-size: 15px; }
  .knapp:hover { color: var(--accent); }
  .mobil { display: none; }
  @media (max-width: 760px) {
    .boks { display: none; }
    .mobil { display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; border-radius: 999px; background: var(--accent); color: #fff; font-weight: 600; }
    .mobil:hover { color: #fff; background: #264c40; }
  }
</style>
