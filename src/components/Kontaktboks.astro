---
// Green contact box beside the page title ("Skriv til hele styret"); the address itself is the link
import Epost from './Epost.astro';
const { tittel = 'Skriv til hele styret', epost } = Astro.props;
---
{epost && (
  <aside class="kontaktboks">
    <span class="tittel">{tittel}</span>
    <a class="adresse" href={`mailto:${epost}`}><Epost adresse={epost} /></a>
  </aside>
)}
<style>
  .kontaktboks { background: var(--accent); color: #fff; border-radius: 22px; padding: 26px 28px; display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .tittel { font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-on); }
  .adresse { font-family: var(--serif); font-size: clamp(19px, 1.6vw, 22px); line-height: 1.25; color: #fff; text-decoration: underline; text-decoration-color: rgba(255, 255, 255, 0.45); text-underline-offset: 4px; }
  .adresse:hover { color: #fff; text-decoration-color: #fff; }
  @media (max-width: 760px) { .kontaktboks { padding: 20px 22px; border-radius: 18px; } }
</style>
