---
// Renders side.seksjoner. Each section decides its own width: tekst (72ch) · bred (content container) · full (edge to edge).
import Innhold from './portable/Innhold.astro';
import Bilde from './portable/Bilde.astro';
import Infoboks from './portable/Infoboks.astro';
import Dokumentliste from './portable/Dokumentliste.astro';
import Medlemsliste from './portable/Medlemsliste.astro';
import Faktaliste from './portable/Faktaliste.astro';
import Kontaktinfo from './portable/Kontaktinfo.astro';
import Knapper from './portable/Knapper.astro';
import Ansvarsliste from './portable/Ansvarsliste.astro';
import HvaSkjer from './portable/HvaSkjer.astro';
import Nokkeltall from './portable/Nokkeltall.astro';
import TunListe from './portable/TunListe.astro';
import Oppgaver from './portable/Oppgaver.astro';
import Dokumentsok from './portable/Dokumentsok.astro';
import AbcUtgaver from './portable/AbcUtgaver.astro';
import Fargebaand from './portable/Fargebaand.astro';
import Borettslagsfakta from './portable/Borettslagsfakta.astro';
import InfoCards from './InfoCards.astro';
import { STANDARD_BREDDE, type Bredde } from '../../sanity/standarder';

const { seksjoner = [], kontakt, barn = [] } = Astro.props;

// Child page cards: where the editor placed an `undersider` section, otherwise at the end (never lost)
const liste: any[] = seksjoner.some((s: any) => s._type === 'undersider') || !barn.length
  ? seksjoner
  : [...seksjoner, { _type: 'undersider', _key: 'auto-undersider' }];

const bredde = (s: any): Bredde =>
  s._type === 'tekst' || s._type === 'infoboks' ? 'tekst' : s._type === 'fargebaand' ? 'full' : (s.bredde ?? STANDARD_BREDDE[s._type as keyof typeof STANDARD_BREDDE] ?? 'tekst');
---
<div class="seksjoner">
  {liste.map((s) => {
    if (s._type === 'undersider' && !barn.length) return null;
    const b = bredde(s);
    return (
      <div class={`seksjon seksjon--${s._type}`} data-bredde={b}>
        <div class={b === 'full' ? undefined : 'container'}>
          <div class={b === 'tekst' ? 'smal' : undefined}>
            {s._type === 'tekst' && <div class="prose"><Innhold value={s.innhold} /></div>}
            {s._type === 'bilde' && <Bilde node={s} bredde={b} />}
            {s._type === 'infoboks' && <Infoboks node={s} />}
            {s._type === 'dokumentliste' && <Dokumentliste node={s} />}
            {s._type === 'oppgaver' && <Oppgaver node={s} styretEpost={kontakt?.epost} />}
            {s._type === 'dokumentsok' && <Dokumentsok node={s} styretEpost={kontakt?.epost} />}
            {s._type === 'abcUtgaver' && <AbcUtgaver node={s} styretEpost={kontakt?.epost} />}
            {s._type === 'medlemsliste' && (s.visning === 'tun' ? <TunListe node={s} /> : <Medlemsliste node={s} styretEpost={kontakt?.epost} />)}
            {s._type === 'faktaliste' && <Faktaliste node={s} />}
            {s._type === 'nokkeltall' && <Nokkeltall node={s} />}
            {s._type === 'arrangementer' && <HvaSkjer node={s} />}
            {s._type === 'kontaktinfo' && <Kontaktinfo node={{ ...s, kontakt }} />}
            {s._type === 'fargebaand' && <Fargebaand node={s} />}
            {s._type === 'borettslagsfakta' && <Borettslagsfakta node={{ ...s, kontakt }} />}
            {s._type === 'knapper' && <Knapper node={s} />}
            {s._type === 'ansvarsliste' && <Ansvarsliste node={s} styretEpost={kontakt?.epost} />}
            {s._type === 'undersider' && (<>{s.tittel && <h2 class="seksjon-tittel">{s.tittel}</h2>}<InfoCards sider={barn} /></>)}
          </div>
        </div>
      </div>
    );
  })}
</div>
