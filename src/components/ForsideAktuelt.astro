---
// Front page "Aktuelt": the featured post (the newest pinned one, else the newest) on the left (7/12) and the next three
// as rows on the right ("Flere saker"). With an image: the image with a white pill over it, then date, title, lead and
// "Les saken"; without one: a typographic panel in the category's tint (house mark, title, lead, date/time/place
// pills, dark button). Each post is one link. Phones: one column and a full-width "Alle saker" button.
import Icon from './Icon.astro';
import KategoriMerke from './KategoriMerke.astro';
import NyhetBilde from './NyhetBilde.astro';
import HusMerke from './HusMerke.astro';
import { docHref, formatDate } from '../lib/urls';
import { fremhevet, kortDato } from '../lib/aktuelt';
import { orddel } from '../lib/orddeling';
import { STANDARD_NYHETSKATEGORI } from '../../sanity/standarder';

interface Props { nyheter: any[]; tittel?: string }
const { tittel = 'Aktuelt' } = Astro.props;
const [forste, etter] = fremhevet(Astro.props.nyheter);
const flere = etter.slice(0, 3);
const farge = forste?.kategori?.farge ?? STANDARD_NYHETSKATEGORI.farge;
const fakta = forste?.fakta;
---
{forste && (
  <section class="container aktuelt" aria-labelledby="forside-aktuelt">
    <div class="hode">
      <h2 id="forside-aktuelt">{tittel}</h2>
      <a class="alle topp" href="/aktuelt">Alle saker<Icon name="ArrowRight" size={16} /></a>
    </div>
    <div class="rutenett">
      {forste.bilde?.asset ? (
        <a class="hoved" href={docHref(forste)}>
          <span class="hoved-ramme">
            <NyhetBilde nyhet={forste} bredde={700} forhold={5 / 3} forholdMobil={16 / 10} sizes="(max-width: 900px) calc(100vw - 2 * var(--gutter)), 700px" class="hoved-bilde" eager />
            <KategoriMerke kategori={forste.kategori} stor hvit class="over" />
          </span>
          <time class="dato" datetime={forste.dato}>{formatDate(forste.dato)}</time>
          <span class="hoved-tittel">{orddel(forste.tittel)}</span>
          <span class="ingress">{forste.ingress}</span>
          <span class="les">Les saken<Icon name="ArrowRight" size={18} /></span>
        </a>
      ) : (
        <a class="panel" href={docHref(forste)} style={`--bg: var(--farge-${farge}-bg); --fg: var(--farge-${farge})`}>
          <HusMerke class="panel-hus" />
          <span class="panel-meta"><KategoriMerke kategori={forste.kategori} stor hvit /><time datetime={forste.dato}>{formatDate(forste.dato)}</time></span>
          <span class="panel-tittel">{orddel(forste.tittel)}</span>
          <span class="panel-ingress">{forste.ingress}</span>
          {(fakta?.dato || fakta?.tid || fakta?.sted) && (
            <span class="fakta">
              {fakta.dato && <span><Icon name="CalendarDays" size={16} />{kortDato(fakta.dato)}</span>}
              {fakta.tid && <span><Icon name="Clock" size={16} />{fakta.tid}</span>}
              {fakta.sted && <span><Icon name="MapPin" size={16} />{fakta.sted}</span>}
            </span>
          )}
          <span class="knapp">Les saken<Icon name="ArrowRight" size={17} /></span>
        </a>
      )}
      {flere.length > 0 && (
        <div class="flere">
          <h3 class="etikett">Flere saker</h3>
          <ul>
            {flere.map((n) => (
              <li>
                <a href={docHref(n)}>
                  <NyhetBilde nyhet={n} bredde={112} forhold={1} sizes="(max-width: 640px) 68px, 112px" class="tommel" />
                  <span class="r-tekst">
                    <span class="r-meta"><KategoriMerke kategori={n.kategori} /><time datetime={n.dato}>{formatDate(n.dato)}</time></span>
                    <span class="r-tittel">{orddel(n.tittel)}</span>
                    <span class="r-ingress">{n.ingress}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
    <a class="alle bunn" href="/aktuelt">Alle saker<Icon name="ArrowRight" size={16} /></a>
  </section>
)}
<style>
  .aktuelt { padding-top: clamp(44px, 7vw, 96px); }
  .hode { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 32px; }
  .hode h2 { font-size: clamp(30px, 3.4vw, 44px); }
  .alle { display: inline-flex; align-items: center; gap: 6px; font-size: 16px; font-weight: 600; color: var(--accent); }
  .alle :global(svg) { transition: transform 0.15s; }
  .alle:hover :global(svg) { transform: translateX(3px); }
  .alle.bunn { display: none; }
  /* Both columns as tall as the taller one: the featured post fills the height of the three rows when its content allows */
  .rutenett { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; align-items: stretch; }

  /* Featured, with an image */
  .hoved { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; color: var(--ink); }
  /* The image takes the height the text leaves (at least 260 px) */
  .hoved-ramme { position: relative; align-self: stretch; flex: 1 1 auto; min-height: 260px; margin-bottom: 6px; }
  .hoved :global(.hoved-bilde) { position: absolute; inset: 0; border-radius: 28px; }
  .hoved :global(.over) { position: absolute; left: 20px; top: 20px; }
  .dato { font-size: 14px; color: var(--muted); }
  .hoved-tittel { font-family: var(--serif); font-size: clamp(26px, 2.8vw, 40px); line-height: 1.08; letter-spacing: -0.015em; overflow-wrap: break-word; hyphens: manual; max-width: 100%; }
  .ingress { font-size: 18px; line-height: 1.6; color: #46514b; }
  .les { display: inline-flex; align-items: center; gap: 6px; padding-top: 4px; font-size: 16px; font-weight: 600; color: var(--accent); }
  .les :global(svg), .knapp :global(svg) { transition: transform 0.15s; }
  .hoved:hover { color: var(--ink); }
  .hoved:hover .hoved-tittel { color: var(--accent); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .hoved:hover .les :global(svg), .panel:hover .knapp :global(svg) { transform: translateX(3px); }

  /* Featured, without an image: a typographic panel in the category's tint */
  .panel { position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: flex-start; gap: 20px; padding: 48px 48px 44px; border-radius: 28px; background: var(--bg); color: var(--ink); }
  .panel-meta, .panel-tittel, .panel-ingress, .fakta, .knapp { position: relative; }
  .panel :global(.panel-hus) { position: absolute; width: 640px; height: 440px; right: -90px; bottom: -90px; color: var(--fg); opacity: 0.12; }
  .panel-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; font-size: 15px; color: #46514b; }
  .panel-tittel { max-width: 620px; font-family: var(--serif); font-size: clamp(30px, 3.8vw, 54px); line-height: 1.05; letter-spacing: -0.015em; overflow-wrap: break-word; hyphens: manual; }
  .panel-ingress { max-width: 560px; font-size: 19px; line-height: 1.6; color: #2e3632; }
  .fakta { display: flex; flex-wrap: wrap; gap: 8px; }
  .fakta > span { display: inline-flex; align-items: center; gap: 7px; padding: 8px 14px; border-radius: 999px; background: #fff; font-size: 15px; font-weight: 600; }
  .fakta :global(svg) { color: var(--fg); flex-shrink: 0; }
  .knapp { margin-top: auto; display: inline-flex; align-items: center; gap: 8px; height: 50px; padding: 0 24px; border-radius: 999px; background: var(--ink); color: #fff; font-size: 16px; font-weight: 600; }
  .panel:hover { color: var(--ink); }
  .panel:hover .panel-tittel { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .panel:hover .knapp { background: #000; }
  .panel:focus-visible { outline-offset: 4px; border-radius: 28px; }

  /* Flere saker */
  .etikett { padding-bottom: 6px; font-family: inherit; font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1.4; color: var(--muted); }
  .flere ul { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
  .flere li { border-top: 1px solid var(--line); }
  .flere li a { display: flex; align-items: flex-start; gap: 18px; padding: 22px 0; color: var(--ink); }
  .flere :global(.tommel) { width: 112px; height: 112px; flex-shrink: 0; border-radius: 18px; }
  .r-tekst { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0; }
  .r-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; font-size: 13px; color: var(--muted); }
  .r-tittel { font-family: var(--serif); font-size: clamp(19px, 1.7vw, 23px); line-height: 1.2; overflow-wrap: break-word; hyphens: manual; max-width: 100%; }
  .r-ingress { font-size: 15px; line-height: 1.5; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
  .flere li a:hover { color: var(--ink); }
  .flere li a:hover .r-tittel { color: var(--accent); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }

  @media (max-width: 1100px) { .rutenett { gap: 40px; } .panel { padding: 40px 36px 36px; } }
  @media (max-width: 900px) {
    .rutenett { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .hoved-ramme { flex: none; height: 380px; min-height: 0; }
  }
  @media (max-width: 640px) {
    .hode { margin-bottom: 16px; }
    .alle.topp { display: none; }
    .alle.bunn { display: flex; justify-content: center; height: 48px; margin-top: 20px; border: 1px solid var(--kant); border-radius: 999px; font-size: 15px; color: var(--ink); }
    .alle.bunn :global(svg) { color: var(--accent); }
    .hoved { gap: 10px; }
    .hoved-ramme { height: 220px; }
    .hoved :global(.hoved-bilde) { border-radius: 20px; }
    .hoved :global(.over) { left: 14px; top: 14px; }
    .dato { font-size: 13px; }
    .ingress { font-size: 15px; line-height: 1.55; }
    .panel { gap: 14px; padding: 24px 22px 26px; border-radius: 20px; }
    .panel :global(.panel-hus) { width: 300px; height: 206px; right: -60px; bottom: -50px; }
    .panel-meta { font-size: 13px; }
    .panel-ingress { font-size: 16px; }
    .fakta > span { padding: 6px 11px; font-size: 13px; }
    .knapp { align-self: stretch; justify-content: center; margin-top: 8px; }
    .etikett { display: none; }
    .flere li a { gap: 14px; padding: 14px 0; }
    .flere :global(.tommel) { width: 68px; height: 68px; border-radius: 12px; }
    .r-tittel { font-size: 18px; }
    .r-ingress { display: none; }
  }
</style>
