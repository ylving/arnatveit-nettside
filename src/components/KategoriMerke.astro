---
// A news item's category (nyhetskategori: title, tint) as a small tinted pill ("Dugnad"). `stor` = the featured post and the article.
import { STANDARD_NYHETSKATEGORI } from '../../sanity/standarder';

interface Props { kategori?: { tittel?: string; farge?: string } | null; stor?: boolean }
const { kategori, stor = false } = Astro.props;
const tittel = kategori?.tittel ?? STANDARD_NYHETSKATEGORI.tittel;
const farge = kategori?.farge ?? STANDARD_NYHETSKATEGORI.farge;
---
<span class:list={['merke', { stor }]} style={`--bg: var(--farge-${farge}-bg); --fg: var(--farge-${farge})`}>{tittel}</span>
<style>
  .merke { display: inline-flex; align-items: center; padding: 3px 9px; border-radius: 999px; background: var(--bg); color: var(--fg); font-size: 12px; font-weight: 600; line-height: 1.4; white-space: nowrap; }
  .stor { padding: 4px 11px; font-size: 13px; }
</style>
