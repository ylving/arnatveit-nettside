---
// "I borettslaget nå" (Aktuelt): a sand band with three modules, each with an ochre eyebrow and a link at the bottom:
// the next upcoming event ("Alle arrangementer" → Dugnad), the newest ABC-nytt (cover and title open the PDF, "Alle
// utgaver" → the ABC-nytt page) and "Har du en sak?" (email to the board).
import AbcForside from './AbcForside.astro';
import Icon from './Icon.astro';
import { docHref } from '../lib/urls';
import { filInfo } from '../lib/dokument';
import { utgaveNavn } from '../../sanity/standarder';

const { neste, abc, epost, dugnad, abcSide } = Astro.props;
const sted = neste && [neste.tid, neste.sted || neste.tun].filter(Boolean).join(' · ');
---
<section class="naa" aria-labelledby="i-borettslaget-naa">
  <div class="container">
    <h2 id="i-borettslaget-naa">I borettslaget nå</h2>
    <div class="moduler">
      <div class="modul">
        <p class="eyebrow">Neste arrangement</p>
        {neste ? (
          <div class="rad">
            <span class="dato" style={`--bg: var(--${neste.kategori}-bg); --fg: var(--${neste.kategori})`}>
              <span class="ukedag">{neste.ukedag}</span><span class="dag">{neste.dag}</span><span class="mnd">{neste.mnd}</span>
            </span>
            <div><p class="tittel">{neste.tittel}</p>{sted && <p class="meta">{sted}</p>}</div>
          </div>
        ) : <p class="tekst">Ingen planlagte arrangementer ennå. Følg med her og i ABC-nytt.</p>}
        {dugnad && <a class="lenke" href={docHref(dugnad)}>Alle arrangementer<Icon name="ArrowRight" size={15} /></a>}
      </div>
      {abc && (
        <div class="modul">
          <p class="eyebrow">Siste ABC-nytt</p>
          <a class="rad abc" href={abc.url} target="_blank" rel="noopener">
            <AbcForside utgave={abc} bredde={64} />
            <span><span class="tittel">{utgaveNavn(abc.maaned, abc.aar)}</span><span class="meta">{filInfo({ ext: 'pdf', size: abc.size })}</span></span>
          </a>
          {abcSide && <a class="lenke" href={docHref(abcSide)}>Alle utgaver<Icon name="ArrowRight" size={15} /></a>}
        </div>
      )}
      {epost && (
        <div class="modul">
          <p class="eyebrow">Har du en sak?</p>
          <div><p class="tittel">Tips styret</p><p class="tekst">Noe naboene bør vite? Send det til styret, så legger vi det ut her.</p></div>
          <a class="lenke" href={`mailto:${epost}`}>Send e-post<Icon name="ArrowRight" size={15} /></a>
        </div>
      )}
    </div>
  </div>
</section>
<style>
  .naa { background: var(--sand); padding-block: clamp(36px, 4vw, 56px); }
  h2 { font-size: clamp(26px, 2.4vw, 32px); margin-bottom: 32px; }
  p { margin: 0; }
  .moduler { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 56px; }
  .modul { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .eyebrow { font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--farge-oker); }
  .rad { display: flex; align-items: center; gap: 18px; color: var(--ink); }
  .dato { width: 72px; height: 82px; flex-shrink: 0; border-radius: 16px; background: var(--bg); color: var(--fg); display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.1; }
  .ukedag { font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  .dag { font-family: var(--serif); font-size: 32px; color: var(--ink); }
  .mnd { font-size: 13px; }
  .tittel { display: block; font-family: var(--serif); font-size: 24px; line-height: 1.2; }
  .meta { display: block; margin-top: 4px; font-size: 15px; color: var(--muted); }
  .tekst { margin-top: 6px; font-size: 15px; line-height: 1.5; color: var(--muted); }
  .abc :global(.forside) { width: 64px; height: auto; flex-shrink: 0; border-radius: 4px; box-shadow: 0 6px 16px rgba(29, 36, 32, 0.16); }
  .abc > span { display: flex; flex-direction: column; }
  .abc:hover .tittel { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .lenke { margin-top: auto; display: inline-flex; align-items: center; gap: 6px; font-size: 15px; font-weight: 600; color: var(--accent); }
  .lenke :global(svg) { transition: transform 0.15s; }
  .lenke:hover :global(svg) { transform: translateX(3px); }
  @media (max-width: 900px) { .moduler { grid-template-columns: minmax(0, 1fr); gap: 36px; } h2 { margin-bottom: 24px; } }
</style>
