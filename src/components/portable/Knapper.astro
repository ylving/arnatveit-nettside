---
import { linkHref } from '../../lib/urls';
const { node } = Astro.props;
---
<p class="knapper">
  {node.lenker?.map((l: any, i: number) => <a class={i === 0 ? 'btn btn--primary' : 'btn'} href={linkHref(l)}>{l.tekst}</a>)}
</p>
<style>
  .knapper { display: flex; flex-wrap: wrap; gap: 12px; margin: 0; }
</style>
