---
// Document rows between lines: icon · title (+ optional description) · "PDF · 118 kB". ABC-nytt style lists group by year.
import Icon from '../Icon.astro';
import { formatSize } from '../../lib/urls';

const { node } = Astro.props;
const { tittel, kategori, grupperEtterAar } = node;
const byTitle = kategori?.sortering === 'tittel';
const docs = [...(node.dokumenter ?? [])].sort((a: any, b: any) =>
  byTitle ? a.tittel.localeCompare(b.tittel, 'nb') : (b.dato ?? '').localeCompare(a.dato ?? '') || a.tittel.localeCompare(b.tittel, 'nb'),
);
const groups: [string, any[]][] = grupperEtterAar
  ? Object.entries(Object.groupBy(docs, (d: any) => d.dato?.slice(0, 4) ?? 'Uten dato')).sort(([a], [b]) => b.localeCompare(a)) as any
  : [['', docs]];
const meta = (d: any) => ['PDF', formatSize(d.size)].filter(Boolean).join(' · ');
---
<section class="doclist">
  {tittel && <h2>{tittel}</h2>}
  {groups.map(([year, items], i) => {
    const liste = (
      <ul>
        {items.map((d: any) => (
          <li>
            <a href={d.url} target="_blank">
              <span class="ic"><Icon name="File" size={18} /></span>
              <span class="tekst">
                <span class="t">{d.tittel}</span>
                {d.beskrivelse && <span class="beskrivelse">{d.beskrivelse}</span>}
              </span>
              <span class="meta">{meta(d)}</span>
            </a>
          </li>
        ))}
      </ul>
    );
    return grupperEtterAar ? (
      <details open={i < 2}>
        <summary><span>{year}</span><span class="count">{items.length} {items.length === 1 ? 'utgave' : 'utgaver'}</span></summary>
        {liste}
      </details>
    ) : liste;
  })}
  {docs.length === 0 && <p class="empty">Ingen dokumenter ennå.</p>}
</section>
<style>
  h2 { margin-bottom: 16px; }
  ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  li { border-bottom: 1px solid var(--line); }
  a { display: flex; align-items: center; gap: 14px; padding: 16px 0; text-decoration: none !important; color: var(--ink) !important; }
  a:hover .t { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .ic { width: 40px; height: 40px; border-radius: 10px; background: var(--accent-soft); color: var(--accent); display: grid; place-items: center; flex-shrink: 0; }
  .tekst { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .t { font-weight: 600; font-size: 16px; line-height: 1.35; }
  .beskrivelse { font-size: 14px; line-height: 1.45; color: var(--muted); }
  .meta { font-size: 13px; color: var(--muted); white-space: nowrap; }
  details + details { margin-top: 10px; }
  summary { cursor: pointer; display: flex; justify-content: space-between; align-items: baseline; padding: 12px 4px; font-family: var(--serif); font-size: 22px; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::before { content: '+'; font-family: var(--sans); width: 24px; color: var(--accent); }
  details[open] summary::before { content: '–'; }
  summary span:first-of-type { flex: 1; }
  .count { font-family: var(--sans); font-size: 14px; color: var(--muted); }
  .empty { color: var(--muted); }
  /* Phones: file type and size under the title instead of beside it */
  @media (max-width: 520px) {
    a { display: grid; grid-template-columns: 40px minmax(0, 1fr); column-gap: 14px; row-gap: 2px; }
    .ic { grid-row: span 2; }
    .meta { grid-column: 2; font-size: 13px; }
  }
</style>
