---
// Document section, list and timeline views (the search view is Dokumentsok), and news attachments: rows from
// DokumentRad, category by category (each sorted as its category says), or a timeline by year like Protokoller.
import DokumentRad from '../DokumentRad.astro';
import Tidslinje from '../Tidslinje.astro';
import { sorter } from '../../lib/dokument';

const { node } = Astro.props;
const { tittel } = node;
const tidslinje = node.visning === 'tidslinje';
const docs = (node.grupper ?? []).filter(Boolean).flatMap((g: any) => sorter(g.dokumenter, g.sortering));
const grupper = tidslinje
  ? (Object.entries(Object.groupBy(docs, (d: any) => d.dato?.slice(0, 4) ?? 'Uten dato')).sort(([a], [b]) => b.localeCompare(a)) as [string, any[]][])
  : [];
---
<section class:list={['doclist', { tidslinjeliste: tidslinje }]}>
  {tittel && <h2>{tittel}</h2>}
  {tidslinje ? <Tidslinje grupper={grupper} /> : <ul>{docs.map((d: any) => <DokumentRad dok={d} />)}</ul>}
  {docs.length === 0 && <p class="empty">Ingen dokumenter ennå.</p>}
</section>
<style>
  h2 { margin-bottom: 16px; }
  /* As a timeline: heading like Protokoller */
  .tidslinjeliste h2 { font-size: 40px; margin-bottom: 20px; }
  ul { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line-2); }
  .empty { color: var(--muted); }
  @media (max-width: 640px) { .tidslinjeliste h2 { font-size: 28px; } }
</style>
