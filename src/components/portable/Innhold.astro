---
import { PortableText } from 'astro-portabletext';
import Link from './Link.astro';
import Dokumentliste from './Dokumentliste.astro';
import Medlemsliste from './Medlemsliste.astro';
import Faktaliste from './Faktaliste.astro';
import Infoboks from './Infoboks.astro';
import Kontaktinfo from './Kontaktinfo.astro';
import Lenkeknapp from './Lenkeknapp.astro';
import Bilde from './Bilde.astro';
import { beskyttTelefonIBlokker } from '../../lib/tekst';

const { value = [], kontakt } = Astro.props;
// Kontaktinfo pulls from «Om borettslaget» — inject it into the block
const blocks = beskyttTelefonIBlokker(value).map((b: any) => (b._type === 'kontaktinfo' ? { ...b, kontakt } : b));
const components = {
  type: { dokumentliste: Dokumentliste, medlemsliste: Medlemsliste, faktaliste: Faktaliste, infoboks: Infoboks, kontaktinfo: Kontaktinfo, lenkeknapp: Lenkeknapp, bilde: Bilde },
  mark: { link: Link },
};
---
<PortableText value={blocks} components={components} />
