---
import { PortableText } from 'astro-portabletext';
import Link from './Link.astro';
import Bilde from './Bilde.astro';
import { beskyttTelefonIBlokker } from '../../lib/tekst';

const { value = [] } = Astro.props;
const blocks = beskyttTelefonIBlokker(value);
// Blocks besides text (sanity/schemaTypes/objects/blocks.ts, `innhold`)
const components = {
  type: { bilde: Bilde },
  mark: { link: Link },
};
---
<PortableText value={blocks} components={components} />
