---
import { beskyttTelefon } from '../../lib/tekst';
const { node } = Astro.props;
---
<section class="facts">
  {node.tittel && <h2>{node.tittel}</h2>}
  <dl>
    {node.rader?.map((r: any) => <div><dt>{r.etikett}</dt><dd>{beskyttTelefon(r.verdi ?? '')}</dd></div>)}
  </dl>
</section>
<style>
  h2 { margin-bottom: 16px; }
  dl { margin: 0; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  div { display: grid; grid-template-columns: minmax(140px, 1fr) 2fr; gap: 16px; padding: 14px 20px; }
  div + div { border-top: 1px solid var(--line-soft); }
  dt { font-weight: 600; }
  dd { margin: 0; white-space: pre-line; color: var(--ink-2); text-wrap: pretty; }
  @media (max-width: 520px) { div { grid-template-columns: 1fr; gap: 2px; } }
</style>
