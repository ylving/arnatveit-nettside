---
// "Hvem kontakter jeg?": one card per area → responsible person, with call and email buttons
import Icon from '../Icon.astro';
import Initialer from '../Initialer.astro';
import { beskyttTelefon } from '../../lib/tekst';
import { telLenke } from '../../lib/medlem';

const { node, styretEpost } = Astro.props;
type Person = { _key: string; navn: string; rolle?: string; telefon?: string; epost?: string; ansvar: { omraade: string; beskrivelse?: string; ikon?: string }[] };
type Utvalg = { _id: string; personer: Person[] };

const rader = ((node.utvalgMedAnsvar ?? []) as Utvalg[])
  .flatMap((u) => u.personer.flatMap(({ ansvar, ...p }) => (ansvar ?? []).map((a) => ({ ...a, ...p }))))
  .sort((a, b) => a.omraade.localeCompare(b.omraade, 'nb'));
const visAnnet = node.visAnnet !== false && styretEpost;
---
<section class="ansvar">
  {node.tittel && <h2>{node.tittel}</h2>}
  {rader.length > 0 ? (
    <ul>
      {rader.map((r) => (
        <li>
          <div class="topp">
            <span class="ikon"><Icon name={r.ikon} size={20} strokeWidth={1.8} /></span>
            <h3>{r.omraade}</h3>
          </div>
          {r.beskrivelse && <p class="beskrivelse">{r.beskrivelse}</p>}
          <div class="person">
            <Initialer navn={r.navn} size={34} />
            <span class="tekst"><strong>{r.navn}</strong>{r.rolle && <span class="rolle">{r.rolle}</span>}</span>
          </div>
          {(r.telefon || r.epost) && (
            <div class="knapper">
              {r.telefon && (
                <a class="knapp knapp--tlf" href={telLenke(r.telefon)} aria-label={`Ring ${r.navn}, ${r.telefon}`}>
                  <Icon name="Phone" size={16} /><span class="bred">{beskyttTelefon(r.telefon)}</span><span class="smal">Ring</span>
                </a>
              )}
              {r.epost && (
                <a class="knapp" href={`mailto:${r.epost}`} title={r.epost} aria-label={`E-post til ${r.navn}: ${r.epost}`}>
                  <Icon name="Mail" size={16} />E-post
                </a>
              )}
            </div>
          )}
        </li>
      ))}
    </ul>
  ) : <p class="tom">Ingen ansvarsområder er registrert ennå.</p>}
  {visAnnet && <p class="annet">Gjelder det noe annet? Skriv til <a href={`mailto:${styretEpost}`}>{styretEpost}</a>.</p>}
</section>
<style>
  h2 { margin-bottom: 20px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 16px; }
  li { background: var(--surface); border: 1px solid var(--line); border-radius: 22px; padding: 24px; display: flex; flex-direction: column; gap: 12px; }
  .topp { display: flex; align-items: center; gap: 12px; }
  .ikon { width: 40px; height: 40px; border-radius: 12px; background: var(--accent-soft); color: var(--accent); display: grid; place-items: center; flex-shrink: 0; }
  h3 { font-size: clamp(22px, 2vw, 25px); margin: 0; }
  .beskrivelse { margin: 0; font-size: 15px; line-height: 1.55; color: var(--ink-2); text-wrap: pretty; }
  .person { display: flex; align-items: center; gap: 10px; margin-top: auto; padding-top: 14px; border-top: 1px solid var(--line-soft); }
  .tekst { display: flex; flex-direction: column; line-height: 1.3; font-size: 15px; }
  .rolle { font-size: 13px; color: var(--muted); }
  .knapper { display: flex; gap: 8px; }
  .knapp { flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 46px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); font-weight: 600; font-size: 15px; white-space: nowrap; }
  .knapp:hover { border-color: var(--ink); color: var(--ink); }
  .knapp--tlf { background: var(--accent); border-color: var(--accent); color: #fff; }
  .knapp--tlf:hover { background: #264c40; color: #fff; }
  .smal { display: none; }
  .annet { margin: 16px 0 0; font-size: 15px; color: var(--ink-2); }
  .annet a { color: var(--accent); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .tom { color: var(--muted); }
  /* Phones: name and role on one line, no avatar; the call button says "Ring" */
  @media (max-width: 560px) {
    .person { border-top: 0; padding-top: 0; }
    .person :global(.initialer) { display: none; }
    .tekst { flex-direction: row; flex-wrap: wrap; gap: 0 6px; }
    .rolle { font-size: 15px; }
    .rolle::before { content: '· '; }
    .bred { display: none; }
    .smal { display: inline; }
  }
</style>
