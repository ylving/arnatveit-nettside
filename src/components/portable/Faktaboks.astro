---
// "Faktaboks": a green panel of short facts (icon, label over value), two per row on wide screens, as the article
// artboard's date and place.
import Icon from '../Icon.astro';
const { node } = Astro.props;
const rader: any[] = node.rader ?? [];
---
{rader.length > 0 && (
  <dl class="fakta">
    {rader.map((r) => (
      <div><Icon name={r.ikon || 'Info'} size={18} /><dt>{r.etikett}</dt><dd>{r.verdi}</dd></div>
    ))}
  </dl>
)}
<style>
  .fakta { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 24px; padding: 20px 24px; border-radius: 18px; background: var(--farge-gronn-bg); }
  .fakta div { display: grid; grid-template-columns: 18px minmax(0, 1fr); column-gap: 12px; align-items: start; }
  .fakta :global(svg) { grid-row: span 2; color: var(--accent); margin-top: 2px; }
  dt { font-size: 13px; color: var(--muted); }
  dd { margin: 0; font-size: 16px; font-weight: 600; overflow-wrap: break-word; }
  @media (max-width: 640px) { .fakta { grid-template-columns: minmax(0, 1fr); gap: 14px; padding: 16px 18px; border-radius: 16px; } }
</style>
