---
// "Siste utgave": the newest ABC-nytt issue beside the page title (pages with an ABC-nytt section)
import Icon from './Icon.astro';
import AbcForside from './AbcForside.astro';
import { filInfo, lastNedUrl } from '../lib/dokument';
import { utgaveNavn } from '../../sanity/standarder';

const { utgave } = Astro.props;
const navn = utgaveNavn(utgave.maaned, utgave.aar);
---
<div class="ramme">
<aside class="abc-siste" aria-label="Siste utgave">
  <a class="omslag" href={utgave.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
    <AbcForside utgave={utgave} bredde={210} sizes="(min-width: 1380px) 210px, (min-width: 650px) and (max-width: 760px) 210px, 118px" eager />
  </a>
  <div class="tekst">
    <p class="kicker">Siste utgave</p>
    <p class="navn">{navn}</p>
    <p class="info">{filInfo(utgave)}</p>
  </div>
  <div class="knapper">
    <a class="btn btn--primary" href={utgave.url} target="_blank" rel="noopener"><Icon name="Eye" size={18} /><span>Les<span class="lang"> utgaven</span></span></a>
    <a class="btn" href={lastNedUrl(utgave)} download={utgave.filnavn ?? ''}><Icon name="Download" size={18} />Last ned</a>
  </div>
</aside>
</div>
<style>
  .abc-siste {
    background: var(--accent-soft); border-radius: 32px; padding: 40px;
    display: grid; grid-template-columns: 210px minmax(0, 1fr); grid-template-rows: auto 1fr; column-gap: 36px; align-items: end;
  }
  .omslag { grid-row: 1 / 3; display: block; }
  .tekst { align-self: end; }
  .tekst p { margin: 0; }
  .kicker { color: var(--accent); }
  .navn { font-family: var(--serif); font-size: 38px; line-height: 1.1; margin-top: 8px !important; }
  .info { font-size: 15px; color: var(--muted); margin-top: 6px !important; }
  .knapper { display: flex; flex-direction: column; gap: 10px; margin-top: 24px; align-self: start; }
  .knapper .btn { min-height: 48px; padding: 0 22px; font-size: 15px; }
  /* Laid out by the panel's own width (it shares the page head with the title): below 560px the cover shrinks
     and sits beside the name, with "Les" and "Last ned" side by side underneath */
  .ramme { container-type: inline-size; }
  @container (max-width: 559px) {
    .abc-siste { border-radius: 24px; padding: 24px; grid-template-columns: 118px minmax(0, 1fr); grid-template-rows: auto auto; column-gap: 20px; align-items: center; }
    .omslag { grid-row: 1; }
    .navn { font-size: 28px; }
    .info { font-size: 14px; }
    .knapper { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 20px; }
    .knapper .btn { padding: 0 12px; gap: 8px; }
  }
  @container (max-width: 400px) {
    .abc-siste { padding: 20px; column-gap: 18px; }
    .navn { font-size: 26px; }
    .lang { display: none; }
  }
</style>
