---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { linkHref, type Link } from '../lib/urls';

interface Props { navn: string; meny: Link[] }
const { navn, meny = [] } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const items = [{ tekst: 'Forside', href: '/' }, ...meny.map((l) => ({ tekst: l?.tekst, href: linkHref(l) }))];
const isCurrent = (href?: string) => (href === '/' ? path === '/' : !!href && (path === href || path.startsWith(`${href}/`)));
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand"><Logo /><span>{navn}</span></a>
    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="hovedmeny">
      <span class="open"><Icon name="menu" /></span><span class="shut"><Icon name="close" /></span>
      <span class="visually-hidden">Meny</span>
    </button>
    <nav id="hovedmeny" aria-label="Hovedmeny">
      <ul>
        {items.map((i) => <li><a href={i.href} aria-current={isCurrent(i.href) ? 'page' : undefined}>{i.tekst}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('menu-open', open);
  });
</script>

<style>
  .site-header { border-bottom: 1px solid var(--line); background: var(--bg); position: relative; z-index: 10; }
  .bar { display: flex; align-items: center; justify-content: space-between; min-height: 88px; gap: 24px; }
  .brand { display: flex; align-items: center; gap: 12px; font-family: var(--serif); font-size: 22px; font-weight: 600; letter-spacing: -0.01em; }
  nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 36px; font-weight: 500; font-size: 16px; }
  nav a[aria-current='page'] { color: var(--accent); text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 2px; }
  .menu-btn { display: none; }

  @media (max-width: 960px) {
    .bar { min-height: 68px; }
    .brand { font-size: 18px; }
    .brand :global(svg) { width: 34px; height: 34px; }
    .menu-btn {
      display: flex; align-items: center; justify-content: center; width: 44px; height: 44px;
      border: 1px solid var(--line); background: var(--surface); border-radius: 12px; color: var(--ink); cursor: pointer;
    }
    .menu-btn .shut, .menu-btn[aria-expanded='true'] .open { display: none; }
    .menu-btn[aria-expanded='true'] .shut { display: block; }
    nav { display: none; position: absolute; inset: 100% 0 auto; background: var(--bg); border-bottom: 1px solid var(--line); padding: 8px var(--gutter) 24px; }
    :global(.menu-open) nav { display: block; }
    nav ul { flex-direction: column; gap: 0; font-size: 18px; }
    nav a { display: block; padding: 14px 0; border-bottom: 1px solid var(--line-soft); }
  }
</style>
