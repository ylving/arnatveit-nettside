---
// Stand-in for a news item's image: the category tint, a white circle with the category icon, and the three-house
// mark in the category colour at 16% opacity, cropped at the bottom right. Decorative. Fills its box and scales with
// the box's height (container units), so the same markup works at 170, 300 or 400 px.
import Icon from './Icon.astro';
import { nyhetKategori } from '../../sanity/standarder';

interface Props { kategori?: string; class?: string }
const { kategori, class: klasse } = Astro.props;
const k = nyhetKategori(kategori);
---
<div class:list={['illu', klasse]} style={`--bg: var(--farge-${k.farge}-bg); --fg: var(--farge-${k.farge})`} aria-hidden="true">
  <svg class="hus" viewBox="5 13 54 37">
    <path fill="currentColor" d="M6 49V32L10 28V21H14V24L18 20L20.232 22.232L16.232 26.232A2.5 2.5 0 0 0 15.5 28V49Z" />
    <path fill="currentColor" d="M48.5 49V28A2.5 2.5 0 0 0 47.768 26.232L44.5 22.964V21.5L46 20L52 26V21H56V30L58 32V49Z" />
    <path fill="currentColor" d="M18 49V28L32 14L38 20V15H42V24L46 28V49Z" />
  </svg>
  <span class="sirkel"><Icon name={k.ikon} size={24} strokeWidth={1.6} /></span>
</div>
<style>
  .illu { container-type: size; position: relative; overflow: hidden; display: grid; place-items: center; background: var(--bg); color: var(--fg); }
  /* Sizes from the artboard's 300 px tall version: mark 288 × 198 at right -36, bottom -31; circle 90; icon 37 */
  .hus { position: absolute; width: 96cqh; height: 66cqh; right: -12cqh; bottom: -10.3cqh; opacity: 0.16; }
  .sirkel { position: relative; width: 30cqh; height: 30cqh; border-radius: 50%; background: #fff; display: grid; place-items: center; }
  .sirkel :global(svg) { width: 41%; height: 41%; }
</style>
