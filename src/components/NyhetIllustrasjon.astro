---
// Stand-in for a news item's image: the category tint, a white circle with the category icon, and the three-house
// mark in the category colour at 16% opacity, cropped at the bottom right. Decorative. Fills its box and scales with
// the box's height (container units), so the same markup works at 170, 300 or 400 px.
import Icon from './Icon.astro';
import HusMerke from './HusMerke.astro';
import { STANDARD_NYHETSKATEGORI } from '../../sanity/standarder';

interface Props { kategori?: { farge?: string; ikon?: string } | null; class?: string }
const { kategori, class: klasse } = Astro.props;
const farge = kategori?.farge ?? STANDARD_NYHETSKATEGORI.farge;
const ikon = kategori?.ikon || STANDARD_NYHETSKATEGORI.ikon;
---
<div class:list={['illu', klasse]} style={`--bg: var(--farge-${farge}-bg); --fg: var(--farge-${farge})`} aria-hidden="true">
  <HusMerke class="hus" />
  <span class="sirkel"><Icon name={ikon} size={24} strokeWidth={1.6} /></span>
</div>
<style>
  .illu { container-type: size; position: relative; overflow: hidden; display: grid; place-items: center; background: var(--bg); color: var(--fg); }
  /* Sizes from the artboard's 300 px tall version: mark 288 × 198 at right -36, bottom -31; circle 90; icon 37 */
  .illu :global(.hus) { position: absolute; width: 96cqh; height: 66cqh; right: -12cqh; bottom: -10.3cqh; opacity: 0.16; }
  /* Relatively larger on small thumbnails (40 px in an 84 px tile) */
  .sirkel { position: relative; width: min(max(30cqh, 40px), 50cqh); height: min(max(30cqh, 40px), 50cqh); border-radius: 50%; background: #fff; display: grid; place-items: center; }
  .sirkel :global(svg) { width: 41%; height: 41%; }
</style>
