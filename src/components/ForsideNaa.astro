---
// Front page "I borettslaget nå": a sand band with three modules split by thin lines: the next event of any category
// (date block in the category's tint, time and place, "Legg i kalender" = the event's own .ics, "Se kommende arrangement"
// = the page whose "Hva skjer" section shows that category first), the newest ABC-nytt (tilted cover, "Les utgaven" opens
// the PDF, "Alle utgaver") and "Skriv til styret" (texts from the section, the board's email from «Om borettslaget»).
// Below 1080px the third module goes under the first two; on phones they stack.
import Icon from './Icon.astro';
import AbcForside from './AbcForside.astro';
import { docHref } from '../lib/urls';
import { NAA_STYRET, utgaveNavn } from '../../sanity/standarder';
import { datoDeler, filnavnFor, kommende, type Arrangement } from '../lib/arrangement';

interface Props {
  arrangementer: Arrangement[];
  arrangementSider: any[];
  abc?: any;
  abcSide?: any;
  styretSide?: any;
  epost?: string;
  styret?: { overtittel?: string; tittel?: string; tekst?: string };
  tittel?: string;
}
const { arrangementer, arrangementSider = [], abc, abcSide, styretSide, epost, styret = {}, tittel = 'I borettslaget nå' } = Astro.props;
const kom = kommende(arrangementer);
const filer = filnavnFor(kom);
const neste = kom[0];
const d = neste && datoDeler(neste);
const sted = neste && (neste.sted || neste.tun);
const side = arrangementSider.find((s) => s.kategori === neste?.kategori) ?? arrangementSider[0];
---
<section class="naa" aria-label={tittel}>
  <div class="container moduler">
    <div class="modul">
      <h2 class="eyebrow">Neste arrangement</h2>
      {neste && d ? (
        <div class="rad" style={`--fg: var(--${neste.kategori}); --bg: var(--${neste.kategori}-bg)`}>
          <span class="dato"><span class="ukedag">{d.ukedag}</span><span class="dag">{d.dag}</span><span class="mnd">{d.maaned.split(' ')[0]}</span></span>
          <div class="tekst">
            <p class="tittel">{neste.tittel}</p>
            <ul class="detaljer">
              <li><Icon name="Clock" size={16} />{d.tid}</li>
              {sted && <li><Icon name="MapPin" size={16} />{sted}</li>}
            </ul>
            <a class="kalender" href={`/kalender/${filer.get(neste._id)}.ics`}><Icon name="CalendarPlus" size={16} />Legg i kalender</a>
          </div>
        </div>
      ) : <p class="tom">Ingen arrangementer er planlagt ennå.</p>}
      {side && (
        <div class="lenker">
          <a href={docHref(side)}>Se kommende arrangement<Icon name="ArrowRight" size={16} /></a>
        </div>
      )}
    </div>
    {abc && (
      <div class="modul">
        <h2 class="eyebrow">Siste ABC-nytt</h2>
        <div class="rad">
          <span class="forside"><AbcForside utgave={abc} bredde={84} /></span>
          <div class="tekst">
            <p class="tittel">{utgaveNavn(abc.maaned, abc.aar)}</p>
            <p class="beskrivelse">Borettslagets informasjonsblad, rundt seks ganger i året.</p>
          </div>
        </div>
        <div class="lenker">
          <a href={abc.url} target="_blank" rel="noopener"><Icon name="BookOpen" size={16} />Les utgaven<span class="visually-hidden"> (PDF)</span></a>
          {abcSide && <a href={docHref(abcSide)}>Alle utgaver<Icon name="ArrowRight" size={16} /></a>}
        </div>
      </div>
    )}
    <div class="modul">
      <h2 class="eyebrow">{styret.overtittel || NAA_STYRET.overtittel}</h2>
      <div class="tekst">
        <p class="tittel">{styret.tittel || NAA_STYRET.tittel}</p>
        <p class="beskrivelse">{styret.tekst || NAA_STYRET.tekst}</p>
      </div>
      <div class="lenker lenker--stablet">
        {epost && <a href={`mailto:${epost}`}><Icon name="Mail" size={16} />{epost}</a>}
        {styretSide && <a href={docHref(styretSide)}>Hvem sitter i styret<Icon name="ArrowRight" size={16} /></a>}
      </div>
    </div>
  </div>
</section>
<style>
  .naa { background: var(--sand); padding-block: clamp(36px, 4.5vw, 64px); margin-top: clamp(56px, 7vw, 96px); }
  .moduler { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .modul { display: flex; flex-direction: column; align-items: flex-start; gap: 22px; min-width: 0; padding-inline: 40px; }
  .modul:first-child { padding-left: 0; }
  .modul:last-child { padding-right: 0; }
  .modul + .modul { border-left: 1px solid #d3cab6; }
  .eyebrow { font-family: inherit; font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1.4; color: var(--farge-oker); }
  p { margin: 0; }
  .rad { display: flex; align-items: flex-start; gap: 22px; }
  .dato { width: 84px; height: 96px; flex-shrink: 0; border-radius: 18px; background: var(--bg); color: var(--fg); display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.1; }
  .ukedag { font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  .dag { font-family: var(--serif); font-size: 38px; line-height: 1; color: var(--ink); margin: 3px 0; }
  .mnd { font-size: 13px; font-weight: 500; }
  .tekst { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .tittel { font-family: var(--serif); font-size: clamp(24px, 2.2vw, 30px); line-height: 1.1; overflow-wrap: break-word; hyphens: auto; }
  .detaljer { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: 15px; color: #46514b; }
  .detaljer li { display: flex; align-items: center; gap: 8px; }
  .detaljer :global(svg) { color: var(--fg); flex-shrink: 0; }
  .kalender { display: inline-flex; align-items: center; gap: 8px; align-self: flex-start; min-height: 32px; font-size: 15px; font-weight: 600; color: var(--accent); }
  .kalender:hover { text-decoration: underline; text-underline-offset: 3px; }
  .beskrivelse { max-width: 300px; font-size: 15px; line-height: 1.55; color: #46514b; }
  .tom { font-size: 16px; color: #46514b; }
  .forside { display: block; width: 84px; flex-shrink: 0; transform: rotate(-3deg); }
  .forside :global(.forside) { display: block; width: 84px; height: auto; border-radius: 5px; box-shadow: 0 2px 4px rgba(29, 36, 32, 0.08), 0 12px 28px rgba(29, 36, 32, 0.16); }
  .lenker { margin-top: auto; display: flex; flex-wrap: wrap; gap: 4px 20px; padding-top: 6px; }
  .lenker--stablet { flex-direction: column; }
  .lenker a { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-size: 15px; font-weight: 600; color: var(--accent); overflow-wrap: anywhere; }
  .lenker--stablet a:not(:last-child) { min-height: 36px; }
  .lenker a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .lenker a :global(svg) { flex-shrink: 0; }
  /* Two columns: event and ABC-nytt side by side, «Skriv til styret» across below */
  @media (max-width: 1080px) {
    .moduler { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 32px; }
    .modul:last-child:nth-child(3) { grid-column: 1 / -1; border-left: 0; border-top: 1px solid #d3cab6; padding: 32px 0 0; }
    .modul:nth-child(2) { padding-right: 0; }
  }
  /* Phones: stacked, lines between */
  @media (max-width: 720px) {
    .moduler { grid-template-columns: minmax(0, 1fr); row-gap: 28px; }
    .modul, .modul:nth-child(2) { padding: 0; }
    .modul + .modul { border-left: 0; border-top: 1px solid #d3cab6; padding-top: 28px; }
  }
  @media (max-width: 640px) {
    .rad { gap: 18px; }
    .dato { width: 76px; height: 88px; border-radius: 16px; }
    .dag { font-size: 32px; margin: 2px 0; }
    .forside, .forside :global(.forside) { width: 66px; }
  }
</style>
