---
import Icon from './Icon.astro';
import { docHref } from '../lib/urls';
const { sider = [] } = Astro.props;
---
<div class="cards">
  {sider.map((s: any) => (
    <a href={docHref(s)} class="card">
      <span class="ic"><Icon name={s.ikon} size={24} strokeWidth={1.8} /></span>
      <span class="t">{s.tittel}</span>
      {s.kort && <span class="d">{s.kort}</span>}
      <span class="chev"><Icon name="chevron" size={18} /></span>
    </a>
  ))}
</div>
<style>
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .card { position: relative; background: var(--surface); border: 1px solid var(--line); border-radius: 24px; padding: 32px; display: flex; flex-direction: column; gap: 16px; min-height: 200px; transition: border-color 0.15s, transform 0.15s; }
  .card:hover { color: var(--ink); border-color: var(--accent); transform: translateY(-2px); }
  .ic { width: 52px; height: 52px; border-radius: 14px; background: var(--accent-soft); color: var(--accent); display: grid; place-items: center; }
  .t { font-family: var(--serif); font-size: 26px; line-height: 1.15; }
  .d { font-size: 15px; line-height: 1.55; color: var(--muted); }
  .chev { display: none; }
  @media (max-width: 960px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; } .card { padding: 24px; } }
  /* Phone: compact list, as in the mobile design */
  @media (max-width: 640px) {
    .cards { grid-template-columns: 1fr; gap: 0; background: var(--surface); border: 1px solid var(--line); border-radius: 20px; overflow: hidden; }
    .card { flex-direction: row; align-items: center; gap: 14px; min-height: 64px; padding: 12px 18px; border: 0; border-radius: 0; }
    .card + .card { border-top: 1px solid var(--line-soft); }
    .card:hover { transform: none; }
    .ic { width: 40px; height: 40px; border-radius: 12px; }
    .ic :global(svg) { width: 20px; height: 20px; }
    .t { flex: 1; font-family: var(--sans); font-weight: 600; font-size: 16px; }
    .d { display: none; }
    .chev { display: block; color: var(--muted); }
  }
</style>
