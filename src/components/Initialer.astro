---
import { initialer } from '../lib/medlem';
const { navn, size = 44 } = Astro.props;
---
<span class="initialer" style={`--s:${size}px`} aria-hidden="true">{initialer(navn)}</span>
<style>
  .initialer { width: var(--s); height: var(--s); flex-shrink: 0; border-radius: 50%; background: var(--accent-soft); color: var(--accent); display: inline-grid; place-items: center; font-weight: 600; font-size: calc(var(--s) * 0.33); letter-spacing: 0.02em; }
</style>
