---
// Aktuelt listing (one page of it): intro, then the posts (8/12) and the aside (4/12); one column on phones with the
// aside after the list. Page 1 features the newest post; the rest are rows with the day number, and a year heading
// wherever the year changes. Pages of NYHETER_PER_SIDE: /aktuelt, /aktuelt/side/2 …
import Base from '../layouts/Base.astro';
import AktueltAside from './AktueltAside.astro';
import KategoriMerke from './KategoriMerke.astro';
import NyhetBilde from './NyhetBilde.astro';
import Icon from './Icon.astro';
import { docHref, formatDate } from '../lib/urls';
import { datoDel } from '../lib/aktuelt';

interface Props { nyheter: any[]; side: number; antallSider: number; aside: any }
const { nyheter, side, antallSider, aside } = Astro.props;
const [forste, ...resten] = side === 1 ? nyheter : [null, ...nyheter];
const rader = resten.map((n, i) => {
  const forrige = i === 0 ? forste : resten[i - 1];
  // Year heading where the year changes, and at the top of pages after the first
  return { n, aar: !forrige || forrige.dato.slice(0, 4) !== n.dato.slice(0, 4) ? n.dato.slice(0, 4) : null };
});
const sideHref = (s: number) => (s === 1 ? '/aktuelt' : `/aktuelt/side/${s}`);
---
<Base title={side === 1 ? 'Aktuelt' : `Aktuelt – side ${side}`} description="Nyheter og beskjeder fra styret og miljøutvalget i Arnatveit Borettslag.">
  <div class="container">
    <header class="page-head">
      <h1>Aktuelt</h1>
      <p class="ingress">Nyheter og beskjeder fra styret og miljøutvalget.</p>
    </header>
    <div class="oppsett">
      <div class="saker">
        {nyheter.length === 0 && (
          <div class="tom">
            <p class="tom-tittel">Ingen saker ennå</p>
            <p>Her kommer nyheter og beskjeder fra styret og miljøutvalget. Til da finner du det meste under Praktisk info.</p>
          </div>
        )}
        {forste && (
          <article class="fremhevet">
            <NyhetBilde nyhet={forste} bredde={420} sizes="(max-width: 900px) calc(100vw - 2 * var(--gutter)), 380px" class="f-bilde" eager />
            <div class="f-tekst">
              <p class="topp"><KategoriMerke kategori={forste.kategori} stor /><time datetime={forste.dato}>{formatDate(forste.dato)}</time></p>
              <h2><a href={docHref(forste)}>{forste.tittel}</a></h2>
              <p class="f-ingress">{forste.ingress}</p>
              <a class="les" href={docHref(forste)} aria-hidden="true" tabindex="-1">Les saken<Icon name="ArrowRight" size={18} /></a>
            </div>
          </article>
        )}
        {rader.length > 0 && (
          <ol class="rader">
            {rader.map(({ n, aar }) => {
              const d = datoDel(n.dato);
              return (
                <>
                  {aar && <li class="aar" aria-hidden="true">{aar}</li>}
                  <li class="rad">
                    <time class="dagblokk" datetime={n.dato}><span class="dag">{d.dag}</span><span class="mnd">{d.mnd}</span><span class="visually-hidden"> {d.aar}</span></time>
                    <div class="r-tekst">
                      <p class="topp"><KategoriMerke kategori={n.kategori} /><span class="r-dato">{formatDate(n.dato)}</span></p>
                      <h3><a href={docHref(n)}>{n.tittel}</a></h3>
                      <p class="r-ingress">{n.ingress}</p>
                    </div>
                    <Icon name="ChevronRight" size={20} />
                  </li>
                </>
              );
            })}
          </ol>
        )}
        {antallSider > 1 && (
          <nav class="sider" aria-label="Sider">
            {side > 1 ? <a href={sideHref(side - 1)}><Icon name="ArrowLeft" size={18} />Nyere saker</a> : <span />}
            <span class="av">Side {side} av {antallSider}</span>
            {side < antallSider ? <a href={sideHref(side + 1)}>Eldre saker<Icon name="ArrowRight" size={18} /></a> : <span />}
          </nav>
        )}
      </div>
      <AktueltAside {...aside} />
    </div>
  </div>
</Base>
<style>
  .oppsett { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: 72px; align-items: start; padding-bottom: clamp(56px, 7vw, 104px); }
  p { margin: 0; }
  .topp { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; font-size: 14px; color: var(--muted); }

  .fremhevet { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 36px; align-items: center; padding-bottom: 40px; position: relative; }
  .fremhevet :global(.f-bilde) { height: 300px; border-radius: 24px; }
  .f-tekst { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .fremhevet h2 { font-size: clamp(28px, 2.6vw, 36px); line-height: 1.12; overflow-wrap: break-word; hyphens: auto; max-width: 100%; }
  .fremhevet h2 a::after { content: ''; position: absolute; inset: 0; }
  .fremhevet h2 a:hover, .fremhevet:hover h2 a { color: var(--accent); }
  .f-ingress { font-size: 17px; line-height: 1.6; color: #46514b; }
  .les { display: inline-flex; align-items: center; gap: 8px; font-size: 16px; font-weight: 600; color: var(--accent); }
  .les :global(svg) { transition: transform 0.15s; }
  .fremhevet:hover .les :global(svg) { transform: translateX(3px); }

  .rader { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
  .aar { font-family: var(--serif); font-size: 26px; line-height: 1.2; color: var(--muted); padding: 28px 0 8px; }
  .rad { position: relative; display: grid; grid-template-columns: 72px minmax(0, 1fr) 24px; gap: 24px; padding: 22px 0; border-top: 1px solid var(--line); }
  .aar + .rad, .rader > .rad:first-child { border-top-color: var(--line); }
  .dagblokk { display: flex; flex-direction: column; }
  .dag { font-family: var(--serif); font-size: 34px; line-height: 1; }
  .mnd { margin-top: 4px; font-size: 14px; color: var(--muted); }
  .r-tekst { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0; }
  .r-dato { display: none; }
  .rad h3 { font-size: 25px; line-height: 1.2; overflow-wrap: break-word; hyphens: auto; max-width: 100%; }
  .rad h3 a::after { content: ''; position: absolute; inset: 0; }
  .rad:hover h3 a { color: var(--accent); }
  /* One line on wide screens */
  .r-ingress { font-size: 16px; line-height: 1.55; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
  .rad > :global(svg) { color: var(--accent); margin-top: 34px; transition: transform 0.15s; }
  .rad:hover > :global(svg) { transform: translateX(3px); }

  .sider { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 32px; font-size: 15px; }
  .sider a { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: var(--accent); }
  .av { color: var(--muted); }
  .tom { padding: 32px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .tom-tittel { font-family: var(--serif); font-size: 26px; margin-bottom: 8px !important; }
  .tom p:not(.tom-tittel) { color: var(--muted); }

  @media (max-width: 1100px) { .oppsett { gap: 48px; } }
  @media (max-width: 900px) {
    .oppsett { grid-template-columns: minmax(0, 1fr); gap: 56px; }
  }
  @media (max-width: 640px) {
    .fremhevet { grid-template-columns: minmax(0, 1fr); gap: 12px; padding-bottom: 28px; }
    .fremhevet :global(.f-bilde) { height: 170px; border-radius: 20px; }
    .f-tekst { gap: 10px; }
    .f-ingress { font-size: 16px; }
    .topp { font-size: 13px; }
    .aar { font-size: 22px; padding: 20px 0 6px; }
    .rad { display: block; padding: 18px 0; }
    .dagblokk, .rad > :global(svg) { display: none; }
    .r-dato { display: inline; }
    .rad h3 { font-size: 21px; }
    .r-ingress { font-size: 15px; line-height: 1.5; -webkit-line-clamp: 3; }
  }
</style>
