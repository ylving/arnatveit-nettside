---
// Small house in the tun's colour (the logo's greens); light ones (C-tunet, Felles) and "Ekstern" get an outline
import { TUN_FARGE, TUN_KANT } from '../lib/medlem';
const { tun, visTekst = true } = Astro.props;
const farge = TUN_FARGE[tun];
const kant = farge && TUN_KANT[tun] !== farge ? TUN_KANT[tun] : undefined;
---
{tun && (
  <span class="tun">
    <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true">
      <path d="M2 7.5 8 2l6 5.5V14H2z" fill={farge ?? 'none'} stroke={kant ?? (farge ? 'none' : 'currentColor')} stroke-width="1.4" stroke-linejoin="round"></path>
    </svg>
    {visTekst && <span>{tun}</span>}
  </span>
)}
<style>
  .tun { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--ink-2); white-space: nowrap; }
  svg { color: var(--muted); flex-shrink: 0; }
</style>
