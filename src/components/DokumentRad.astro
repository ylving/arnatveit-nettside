---
// One document (PDF) in any list on the site: tinted category icon · title (+ tun tag, description) · "PDF · 37 kB" ·
// a round download button. The whole row opens the file (the title link covers it); the download button sits above.
// Render inside a <ul> (Dokumentliste, Dokumentsok).
import Icon from './Icon.astro';
import TunMerke from './TunMerke.astro';
import { filInfo, lastNedUrl, type Dokument } from '../lib/dokument';
import { STANDARD_FARGE } from '../../sanity/standarder';

type Props = { dok: Dokument } & Record<string, unknown>;
const { dok, ...attrs } = Astro.props;
const farge = dok.kategori?.farge ?? STANDARD_FARGE;
const info = filInfo(dok);
---
<li class="dokument-rad" {...attrs}>
  <span class="ikon" style={`--bg: var(--farge-${farge}-bg); --fg: var(--farge-${farge})`}><Icon name={dok.kategori?.ikon || 'FileText'} size={22} strokeWidth={1.8} /></span>
  <div class="tekst">
    <a class="tittel" href={dok.url} target="_blank" rel="noopener">{dok.tittel}</a>
    {(dok.tun || dok.beskrivelse || info) && (
      <div class="meta">
        <span class:list={['fakta', { 'uten-tun': !dok.tun }]}>
          {dok.tun && <TunMerke tun={dok.tun} />}
          <span class="info-mobil">{info}</span>
        </span>
        {dok.beskrivelse && <span class="beskrivelse">{dok.beskrivelse}</span>}
      </div>
    )}
  </div>
  <span class="info">{info}</span>
  <span class="handlinger">
    <a class="last-ned" href={lastNedUrl(dok)} download={dok.filnavn ?? ''} aria-label={`Last ned ${dok.tittel}`}><Icon name="Download" size={16} /></a>
  </span>
</li>
<style>
  .dokument-rad {
    display: grid; grid-template-columns: 48px minmax(0, 1fr) auto auto; align-items: center; gap: 18px;
    padding: 16px 0; border-top: 1px solid var(--line-2); position: relative;
  }
  .ikon { width: 48px; height: 48px; border-radius: 12px; background: var(--bg); color: var(--fg); display: grid; place-items: center; }
  .tekst { display: flex; flex-direction: column; gap: 3px; }
  .tittel { font-weight: 600; font-size: 17px; line-height: 1.35; color: var(--ink); }
  .tittel::after { content: ''; position: absolute; inset: 0; }
  .dokument-rad:hover .tittel { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .tittel:focus-visible { outline: none; }
  .tittel:focus-visible::after { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 8px; }
  .meta { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 12px; row-gap: 2px; font-size: 15px; line-height: 1.45; color: var(--muted); }
  .fakta { display: inline-flex; align-items: center; gap: 10px; }
  .fakta :global(.tun) { font-size: 14px; font-weight: 500; color: var(--ink-2); }
  .info-mobil, .uten-tun { display: none; }
  .info { font-size: 14px; color: var(--faint); white-space: nowrap; min-width: 88px; text-align: right; }
  .handlinger { display: flex; align-items: center; gap: 10px; }
  .last-ned { position: relative; z-index: 1; width: 38px; height: 38px; border-radius: 50%; background: var(--accent); color: #fff; display: grid; place-items: center; flex-shrink: 0; }
  .last-ned:hover { background: #264c40; color: #fff; }

  /* Phones: icon · title (wraps) with tun and size below · download icon */
  @media (max-width: 640px) {
    .dokument-rad { grid-template-columns: 40px minmax(0, 1fr) 44px; gap: 14px; padding: 14px 0; }
    .ikon { width: 40px; height: 40px; border-radius: 10px; }
    .ikon :global(svg) { width: 20px; height: 20px; }
    .tittel { font-size: 15px; }
    .meta { flex-direction: column; align-items: flex-start; font-size: 13px; }
    .fakta { gap: 8px; }
    .fakta :global(.tun) { font-size: 13px; }
    .fakta :global(.tun)::after { content: '·'; margin-left: 2px; color: var(--faint); }
    .uten-tun { display: inline-flex; }
    .info-mobil { display: inline; color: var(--faint); }
    .beskrivelse { font-size: 14px; }
    .info { display: none; }
    /* 44px touch target */
    .last-ned { width: 44px; height: 44px; background: none; color: var(--accent); }
    .last-ned:hover { background: var(--accent-soft); color: var(--accent); }
  }
</style>
