---
import { docHref } from '../lib/urls';
import LogoMark from '../assets/brand/arnatveit-logo-on-dark.svg';
const { innstillinger } = Astro.props;
const { navn, beskrivelse, kontakt, praktiskInfo = [] } = innstillinger;
---
<footer class="site-footer">
  <div class="container">
    <div class="grid">
      <div class="about">
        <span class="name"><LogoMark class="mark" aria-hidden="true" />{navn}</span>
        {beskrivelse && <p>{beskrivelse}</p>}
      </div>
      <div class="col">
        <span class="head">Praktisk info</span>
        {praktiskInfo.map((s: any) => <a href={docHref(s)}>{s.tittel}</a>)}
        <a href="/dokumentsenter">Dokumentsenter</a>
      </div>
      <div class="col">
        <span class="head">Kontakt styret</span>
        {kontakt?.epost && <a href={`mailto:${kontakt.epost}`}>{kontakt.epost}</a>}
        <a href="/kontakt">Adresser og kontaktinfo</a>
      </div>
    </div>
    <div class="bottom">© {new Date().getFullYear()} {navn}</div>
  </div>
</footer>
<style>
  .site-footer { background: var(--footer-bg); color: var(--footer-ink); padding-block: clamp(40px, 5vw, 64px) 40px; margin-top: auto; }
  .grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 40px; }
  .name { display: flex; align-items: center; gap: 14px; font-family: var(--serif); font-size: clamp(24px, 2.2vw, 28px); font-weight: 600; color: #fff; }
  .name :global(.mark) { height: 44px; width: auto; flex-shrink: 0; }
  .about p { margin: 14px 0 0; font-size: 15px; color: #b9b4aa; max-width: 380px; }
  .col { display: flex; flex-direction: column; gap: 12px; font-size: 15px; }
  .head { font-weight: 600; color: #fff; }
  .col a:hover { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
  .bottom { border-top: 1px solid var(--footer-line); margin-top: 48px; padding-top: 24px; font-size: 14px; color: var(--footer-muted); }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; gap: 28px; } .bottom { margin-top: 28px; } }
</style>
