---
// The listing's aside: "Neste arrangement" (the next upcoming event, all events on Dugnad), "Siste ABC-nytt" (cover,
// opens the PDF) and "Har du en sak?" (email to the board). Each module has a 2px dark rule on top.
import AbcForside from './AbcForside.astro';
import Epost from './Epost.astro';
import Icon from './Icon.astro';
import { docHref } from '../lib/urls';
import { filInfo } from '../lib/dokument';
import { utgaveNavn } from '../../sanity/standarder';

const { neste, abc, epost, dugnad } = Astro.props;
const sted = neste && [neste.tid, neste.sted || neste.tun].filter(Boolean).join(' · ');
---
<aside class="aside" aria-label="Mer fra borettslaget">
  <section class="modul">
    <h2>Neste arrangement</h2>
    {neste ? (
      <div class="arr">
        <span class="dato" style={`--bg: var(--${neste.kategori}-bg); --fg: var(--${neste.kategori})`}>
          <span class="ukedag">{neste.ukedag}</span><span class="dag">{neste.dag}</span><span class="mnd">{neste.mnd}</span>
        </span>
        <div><p class="tittel">{neste.tittel}</p>{sted && <p class="meta">{sted}</p>}</div>
      </div>
    ) : <p class="tekst">Ingen planlagte arrangementer ennå. Følg med her og i ABC-nytt.</p>}
    {dugnad && <a class="lenke" href={docHref(dugnad)}>Se alle arrangementer<Icon name="ArrowRight" size={16} /></a>}
  </section>
  {abc && (
    <section class="modul">
      <h2>Siste ABC-nytt</h2>
      <a class="abc" href={abc.url} target="_blank" rel="noopener">
        <AbcForside utgave={abc} bredde={60} />
        <span><span class="tittel">{utgaveNavn(abc.maaned, abc.aar)}</span><span class="meta">{filInfo({ ext: 'pdf', size: abc.size })}</span></span>
      </a>
    </section>
  )}
  {epost && (
    <section class="modul smal">
      <h2>Har du en sak?</h2>
      <p class="tekst">Tips styret om noe naboene bør vite.</p>
      <a class="epost" href={`mailto:${epost}`}><Epost adresse={epost} /></a>
    </section>
  )}
</aside>
<style>
  .aside { display: flex; flex-direction: column; gap: 36px; }
  .modul { border-top: 2px solid var(--ink); padding-top: 18px; display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .modul.smal { gap: 8px; }
  h2 { font-family: inherit; font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1.4; color: var(--muted); }
  p { margin: 0; }
  .arr { display: flex; align-items: center; gap: 16px; }
  .dato { width: 60px; height: 68px; flex-shrink: 0; border-radius: 14px; background: var(--bg); color: var(--fg); display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.1; }
  .ukedag { font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  .dag { font-family: var(--serif); font-size: 26px; color: var(--ink); }
  .mnd { font-size: 12px; }
  .tittel { font-family: var(--serif); font-size: 21px; line-height: 1.2; }
  .meta { display: block; margin-top: 4px; font-size: 14px; color: var(--muted); }
  .tekst { font-size: 15px; line-height: 1.55; color: #46514b; }
  .lenke { display: inline-flex; align-items: center; gap: 6px; font-size: 15px; font-weight: 600; color: var(--accent); }
  .lenke :global(svg) { transition: transform 0.15s; }
  .lenke:hover :global(svg) { transform: translateX(3px); }
  .abc { display: flex; align-items: center; gap: 16px; color: var(--ink); }
  .abc :global(.forside) { width: 60px; height: auto; flex-shrink: 0; border-radius: 4px; box-shadow: 0 4px 12px rgba(29, 36, 32, 0.14); }
  .abc > span { display: flex; flex-direction: column; }
  .abc:hover .tittel { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .epost { font-size: 15px; font-weight: 600; color: var(--accent); text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; }
  @media (max-width: 640px) { .aside { gap: 28px; } }
</style>
