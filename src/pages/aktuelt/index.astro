---
import Base from '../../layouts/Base.astro';
import { load } from '../../lib/sanity';
import { docHref, formatDate } from '../../lib/urls';

const nyheter = await load<any[]>(`*[_type == "nyhet"] | order(dato desc){ _type, tittel, dato, merkelapp, ingress, "slug": slug.current }`);
---
<Base title="Aktuelt" description="Nyheter fra Arnatveit Borettslag">
  <div class="container">
    <header class="page-head"><h1>Aktuelt</h1></header>
    <ul class="list">
      {nyheter.map((n) => (
        <li>
          <a href={docHref(n)}>
            <span class="meta">{[formatDate(n.dato), n.merkelapp].filter(Boolean).join(' · ')}</span>
            <span class="t">{n.tittel}</span>
            <span class="d">{n.ingress}</span>
          </a>
        </li>
      ))}
    </ul>
    {nyheter.length === 0 && <p>Ingen nyheter ennå.</p>}
  </div>
</Base>
<style>
  .list { list-style: none; margin: 0; padding: 0 0 clamp(56px, 8vw, 112px); display: flex; flex-direction: column; gap: 16px; max-width: 820px; }
  a { display: flex; flex-direction: column; gap: 8px; background: var(--surface); border: 1px solid var(--line); border-radius: 24px; padding: clamp(22px, 3vw, 32px); }
  a:hover { color: var(--ink); border-color: var(--accent); }
  .meta { font-size: 14px; color: var(--muted); }
  .t { font-family: var(--serif); font-size: clamp(24px, 2.6vw, 30px); line-height: 1.15; }
  .d { color: var(--ink-2); }
</style>
