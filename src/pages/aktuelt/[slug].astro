---
// A news article: back link, category + date, title, lead; then a 720px body column (image or the fallback illustration,
// facts panel, text, attachments, a link row to a page) with "Del saken" beside it on wide screens and after it on
// phones; "Flere saker" (three other recent posts) at the bottom. Shares with its own image or the category's.
import Base from '../../layouts/Base.astro';
import Innhold from '../../components/portable/Innhold.astro';
import Dokumentliste from '../../components/portable/Dokumentliste.astro';
import KategoriMerke from '../../components/KategoriMerke.astro';
import NyhetBilde from '../../components/NyhetBilde.astro';
import Lenkerader from '../../components/Lenkerader.astro';
import Icon from '../../components/Icon.astro';
import { load, urlFor } from '../../lib/sanity';
import { DOKUMENT, INNHOLD, NYHET_FELT, NYHET_KORT, SIDE_KORT } from '../../lib/queries';
import { docHref, formatDate } from '../../lib/urls';
import { nyhetKategori } from '../../../sanity/standarder';

export async function getStaticPaths() {
  const slugs = await load<string[]>(`*[_type == "nyhet" && defined(slug.current)].slug.current`);
  return slugs.map((slug) => ({ params: { slug } }));
}
const n = await load<any>(
  `*[_type == "nyhet" && slug.current == $slug][0]{
    ${NYHET_FELT}, seo, fakta, ${INNHOLD},
    "dokumenter": dokumenter[]->${DOKUMENT},
    relatert{ tittel, tekst, "side": side->${SIDE_KORT} },
    "flere": *[_type == "nyhet" && _id != ^._id && defined(slug.current)] | order(dato desc, _createdAt desc)[0...3]${NYHET_KORT}
  }`,
  { slug: Astro.params.slug },
);
const dokumenter = (n.dokumenter ?? []).filter((d: any) => d?.url);
const relatert = n.relatert?.side ? [{ side: n.relatert.side, tittel: n.relatert.tittel || n.relatert.side.tittel, tekst: n.relatert.tekst || n.relatert.side.kort }] : [];
const faktaDato = n.fakta?.dato && new Intl.DateTimeFormat('nb-NO', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(`${n.fakta.dato}T12:00:00`));
// "torsdag 28. mai 2026" → "Torsdag 28. mai 2026"
const faktaDatoTekst = faktaDato && faktaDato.charAt(0).toUpperCase() + faktaDato.slice(1);
// Share image: the post's image cropped to 1200 × 630 around its hotspot, else the category's generated image
const ogBilde = n.bilde?.asset ? urlFor(n.bilde).width(1200).height(630).fit('crop').url() : `/og/${nyhetKategori(n.kategori).verdi}.png`;
---
<Base title={n.seo?.tittel ?? n.tittel} description={n.seo?.beskrivelse ?? n.ingress} bilde={ogBilde} type="article">
  <article class="container artikkel">
    <header class="hode">
      <a class="tilbake" href="/aktuelt"><Icon name="ChevronLeft" size={16} />Aktuelt</a>
      <p class="topp"><KategoriMerke kategori={n.kategori} stor /><time datetime={n.dato}>{formatDate(n.dato)}</time></p>
      <h1>{n.tittel}</h1>
      <p class="ingress">{n.ingress}</p>
    </header>
    <div class="kropp">
      <div class="hovedspalte">
        <NyhetBilde nyhet={n} bredde={720} sizes="(max-width: 800px) calc(100vw - 2 * var(--gutter)), 720px" class="a-bilde" eager />
        {(faktaDatoTekst || n.fakta?.sted) && (
          <dl class="fakta">
            {faktaDatoTekst && <div><Icon name="CalendarDays" size={18} /><dt>Dato</dt><dd>{faktaDatoTekst}</dd></div>}
            {n.fakta?.sted && <div><Icon name="MapPin" size={18} /><dt>Sted</dt><dd>{n.fakta.sted}</dd></div>}
          </dl>
        )}
        {n.innhold?.length > 0 && <div class="prose brodtekst"><Innhold value={n.innhold} /></div>}
        {dokumenter.length > 0 && <div class="vedlegg"><Dokumentliste node={{ tittel: 'Vedlegg', grupper: [{ sortering: 'tittel', dokumenter }] }} /></div>}
        {relatert.length > 0 && <div class="relatert"><Lenkerader lenker={relatert} /></div>}
      </div>
      <div class="del">
        <p class="del-tittel">Del saken</p>
        <button type="button" class="kopier" hidden>
          <Icon name="Link" size={16} /><span class="kopier-tekst">Kopier lenke</span>
        </button>
        <span class="visually-hidden" role="status" aria-live="polite"></span>
        <script is:inline>
          (() => {
            const del = document.currentScript.parentElement;
            const knapp = del.querySelector('.kopier');
            const tekst = knapp.querySelector('.kopier-tekst');
            const status = del.querySelector('[role="status"]');
            if (!navigator.clipboard) { del.hidden = true; return; }
            knapp.hidden = false;
            let tidsur;
            knapp.addEventListener('click', async () => {
              try {
                await navigator.clipboard.writeText(location.href.split('#')[0]);
                tekst.textContent = status.textContent = 'Lenke kopiert';
              } catch {
                tekst.textContent = status.textContent = 'Kunne ikke kopiere';
              }
              clearTimeout(tidsur);
              tidsur = setTimeout(() => { tekst.textContent = 'Kopier lenke'; status.textContent = ''; }, 2500);
            });
          })();
        </script>
      </div>
    </div>
  </article>
  {n.flere?.length > 0 && (
    <section class="container flere" aria-labelledby="flere-saker">
      <div class="flere-topp">
        <h2 id="flere-saker">Flere saker</h2>
        <a class="alle" href="/aktuelt">Alle saker<Icon name="ArrowRight" size={16} /></a>
      </div>
      <ul>
        {n.flere.map((f: any) => (
          <li>
            <p class="topp"><KategoriMerke kategori={f.kategori} /><time datetime={f.dato}>{formatDate(f.dato)}</time></p>
            <h3><a href={docHref(f)}>{f.tittel}</a></h3>
            <p class="f-ingress">{f.ingress}</p>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
<style>
  p { margin: 0; }
  .artikkel { padding-block: clamp(24px, 4vw, 56px) clamp(44px, 6vw, 88px); }
  .hode { max-width: 820px; display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .tilbake { display: inline-flex; align-items: center; gap: 4px; font-size: 15px; font-weight: 600; color: var(--accent); margin-bottom: 8px; }
  .tilbake:hover { text-decoration: underline; text-underline-offset: 3px; }
  .topp { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; font-size: 15px; color: var(--muted); }
  .artikkel h1 { font-size: clamp(34px, 4.6vw, 60px); line-height: 1.06; letter-spacing: -0.02em; overflow-wrap: break-word; hyphens: auto; max-width: 100%; }
  .ingress { font-size: clamp(18px, 1.6vw, 22px); line-height: 1.55; color: var(--ink-2); }

  .kropp { display: grid; grid-template-columns: minmax(0, 720px) minmax(0, 1fr); gap: 32px 72px; margin-top: 36px; align-items: start; }
  .hovedspalte { display: flex; flex-direction: column; gap: 32px; min-width: 0; }
  .hovedspalte :global(.a-bilde) { aspect-ratio: 16 / 9; height: auto; border-radius: 24px; }
  .fakta { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; padding: 20px 24px; border-radius: 18px; background: var(--farge-gronn-bg); }
  .fakta div { display: grid; grid-template-columns: 18px minmax(0, 1fr); column-gap: 12px; align-items: start; }
  .fakta :global(svg) { grid-row: span 2; color: var(--accent); margin-top: 2px; }
  .fakta dt { font-size: 13px; color: var(--muted); }
  .fakta dd { margin: 0; font-size: 16px; font-weight: 600; }
  .brodtekst { padding-bottom: 0; max-width: none; font-size: 18px; line-height: 1.7; color: #2e3632; }
  .vedlegg :global(h2) { font-size: clamp(24px, 2.4vw, 28px); }
  .del { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .del-tittel { font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .kopier {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 42px; padding: 0 16px; border-radius: 999px;
    border: 1px solid var(--kant); background: var(--surface); font: inherit; font-size: 15px; font-weight: 600; color: var(--ink); cursor: pointer;
  }
  .kopier:hover { border-color: var(--ink); }

  .flere { padding-bottom: clamp(56px, 8vw, 112px); }
  .flere-topp { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 24px; }
  .flere h2 { font-size: clamp(26px, 2.8vw, 36px); }
  .alle { display: inline-flex; align-items: center; gap: 6px; font-size: 15px; font-weight: 600; color: var(--accent); white-space: nowrap; }
  .alle :global(svg) { transition: transform 0.15s; }
  .alle:hover :global(svg) { transform: translateX(3px); }
  .flere ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .flere li { position: relative; border-top: 1px solid #cfc8ba; padding-top: 18px; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .flere .topp { font-size: 14px; }
  .flere h3 { font-size: 22px; line-height: 1.2; overflow-wrap: break-word; hyphens: auto; max-width: 100%; }
  .flere h3 a::after { content: ''; position: absolute; inset: 0; }
  .flere li:hover h3 a { color: var(--accent); }
  .f-ingress { font-size: 15px; line-height: 1.5; color: var(--muted); }

  @media (max-width: 1000px) {
    .kropp { grid-template-columns: minmax(0, 1fr); }
    .hovedspalte { max-width: 720px; }
  }
  @media (max-width: 900px) { .flere ul { grid-template-columns: minmax(0, 1fr); gap: 0; } .flere li { padding-block: 16px; border-top-color: var(--line); } }
  @media (max-width: 640px) {
    .topp { font-size: 13px; }
    .hovedspalte { gap: 24px; }
    .hovedspalte :global(.a-bilde) { border-radius: 20px; }
    .fakta { grid-template-columns: minmax(0, 1fr); gap: 14px; padding: 16px 18px; border-radius: 16px; }
    .brodtekst { font-size: 16px; }
    .del-tittel { display: none; }
    .del, .kopier { align-self: stretch; }
    .kopier { height: 46px; }
    .flere h3 { font-size: 19px; }
  }
</style>
