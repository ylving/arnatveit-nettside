---
// A news article: a header band in the category's tint (the three-house mark large at the bottom right) with the back
// link, a white pill with the category's icon, the date, the title, the lead and date/place as white boxes; then a
// 720px column with the main image (if any), the editor's blocks in order, the attachments in a white panel and
// "Kopier lenke"; "Flere saker" (three other recent posts) in a sand band, as white cards so the tints stand out.
// Shares with its own image or its colour's.
import Base from '../../layouts/Base.astro';
import Innhold from '../../components/portable/Innhold.astro';
import Bilde from '../../components/portable/Bilde.astro';
import Faktaboks from '../../components/portable/Faktaboks.astro';
import Relatert from '../../components/portable/Relatert.astro';
import DokumentRad from '../../components/DokumentRad.astro';
import NyhetBilde from '../../components/NyhetBilde.astro';
import KategoriMerke from '../../components/KategoriMerke.astro';
import HusMerke from '../../components/HusMerke.astro';
import Icon from '../../components/Icon.astro';
import { load, urlFor } from '../../lib/sanity';
import { DOKUMENT, NYHET_FELT, NYHET_KORT, NYHET_SEKSJONER } from '../../lib/queries';
import { sorter } from '../../lib/dokument';
import { docHref, formatDate } from '../../lib/urls';
import { orddel } from '../../lib/orddeling';
import { STANDARD_NYHETSKATEGORI } from '../../../sanity/standarder';

export async function getStaticPaths() {
  const slugs = await load<string[]>(`*[_type == "nyhet" && defined(slug.current)].slug.current`);
  return slugs.map((slug) => ({ params: { slug } }));
}
const n = await load<any>(
  `*[_type == "nyhet" && slug.current == $slug][0]{
    ${NYHET_FELT}, seo, fakta, ${NYHET_SEKSJONER},
    "dokumenter": dokumenter[]->${DOKUMENT},
    "flere": *[_type == "nyhet" && _id != ^._id && defined(slug.current)] | order(dato desc, _createdAt desc)[0...3]${NYHET_KORT}
  }`,
  { slug: Astro.params.slug },
);
const kategori = { ...STANDARD_NYHETSKATEGORI, ...n.kategori };
const dokumenter = sorter((n.dokumenter ?? []).filter((d: any) => d?.url), 'tittel');
const dag = n.fakta?.dato && new Intl.DateTimeFormat('nb-NO', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(`${n.fakta.dato}T12:00:00`));
// "torsdag 28. mai 2026" → "Torsdag 28. mai 2026"
const faktaDato = dag && dag.charAt(0).toUpperCase() + dag.slice(1);
// Share image: the post's image cropped to 1200 × 630 around its hotspot, else the generated image in the category's colour
const ogBilde = n.bilde?.asset ? urlFor(n.bilde).width(1200).height(630).fit('crop').url() : `/og/${kategori.farge}.png`;
---
<Base title={n.seo?.tittel ?? n.tittel} description={n.seo?.beskrivelse ?? n.ingress} bilde={ogBilde} type="article">
  <article>
    <header class="hode" style={`--bg: var(--farge-${kategori.farge}-bg); --fg: var(--farge-${kategori.farge})`}>
      <HusMerke class="hode-hus" />
      <div class="container hode-innhold">
        <a class="tilbake" href="/aktuelt"><Icon name="ArrowLeft" size={16} />Aktuelt</a>
        <p class="meta">
          <KategoriMerke kategori={kategori} stor hvit />
          <time datetime={n.dato}>{formatDate(n.dato)}</time>
        </p>
        <h1>{orddel(n.tittel)}</h1>
        <p class="ingress">{n.ingress}</p>
        {(faktaDato || n.fakta?.sted) && (
          <ul class="fakta">
            {faktaDato && <li><Icon name="CalendarDays" size={16} /><time datetime={n.fakta.dato}>{faktaDato}</time></li>}
            {n.fakta?.sted && <li><Icon name="MapPin" size={16} />{n.fakta.sted}</li>}
          </ul>
        )}
      </div>
    </header>
    <div class="container">
      <div class="kropp">
        {n.bilde?.asset && <NyhetBilde nyhet={n} bredde={720} forhold={16 / 9} sizes="(max-width: 800px) calc(100vw - 2 * var(--gutter)), 720px" class="a-bilde" eager />}
        {(n.seksjoner ?? []).map((b: any) => (
          b._type === 'tekst' ? <div class="prose brodtekst"><Innhold value={b.innhold} /></div>
          : b._type === 'bilde' ? <Bilde node={b} />
          : b._type === 'faktaboks' ? <Faktaboks node={b} />
          : b._type === 'relatert' ? <Relatert node={b} />
          : null
        ))}
        {dokumenter.length > 0 && (
          <section class="vedlegg" aria-labelledby="vedlegg">
            <h2 id="vedlegg">Vedlegg</h2>
            <ul>{dokumenter.map((d: any) => <DokumentRad dok={d} />)}</ul>
          </section>
        )}
        <div class="del">
          <button type="button" class="kopier" hidden>
            <Icon name="Link" size={16} /><span class="kopier-tekst">Kopier lenke</span>
          </button>
          <span class="visually-hidden" role="status" aria-live="polite"></span>
          <script is:inline>
            (() => {
              const del = document.currentScript.parentElement;
              const knapp = del.querySelector('.kopier');
              const tekst = knapp.querySelector('.kopier-tekst');
              const status = del.querySelector('[role="status"]');
              if (!navigator.clipboard) { del.hidden = true; return; }
              knapp.hidden = false;
              let tidsur;
              knapp.addEventListener('click', async () => {
                try {
                  await navigator.clipboard.writeText(location.href.split('#')[0]);
                  tekst.textContent = status.textContent = 'Lenke kopiert';
                } catch {
                  tekst.textContent = status.textContent = 'Kunne ikke kopiere';
                }
                clearTimeout(tidsur);
                tidsur = setTimeout(() => { tekst.textContent = 'Kopier lenke'; status.textContent = ''; }, 2500);
              });
            })();
          </script>
        </div>
      </div>
    </div>
  </article>
  {n.flere?.length > 0 && (
    <section class="flere" aria-labelledby="flere-saker">
      <div class="container">
        <div class="flere-topp">
          <h2 id="flere-saker">Flere saker</h2>
          <a class="alle" href="/aktuelt">Alle saker<Icon name="ArrowRight" size={16} /></a>
        </div>
        <ul>
          {n.flere.map((f: any) => (
            <li>
              <a href={docHref(f)}>
                <NyhetBilde nyhet={f} bredde={380} forhold={2.1} forholdMobil={1} sizes="(max-width: 900px) 84px, 380px" class="f-bilde" />
                <span class="f-tekst">
                  <span class="f-meta"><KategoriMerke kategori={f.kategori} /><time datetime={f.dato}>{formatDate(f.dato)}</time></span>
                  <span class="f-tittel">{orddel(f.tittel)}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>
<style>
  p { margin: 0; }
  /* Header band */
  .hode { position: relative; overflow: hidden; background: var(--bg); padding-block: clamp(24px, 3.5vw, 48px) clamp(32px, 4.5vw, 64px); }
  .hode :global(.hode-hus) { position: absolute; width: 620px; height: 425px; right: -80px; bottom: -70px; color: var(--fg); opacity: 0.12; }
  .hode-innhold { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .tilbake { display: inline-flex; align-items: center; gap: 6px; font-size: 15px; font-weight: 600; color: var(--fg); margin-bottom: 6px; }
  .tilbake:hover { color: var(--fg); text-decoration: underline; text-underline-offset: 3px; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; font-size: 15px; color: #46514b; }
  .hode h1 { font-size: clamp(36px, 5vw, 72px); line-height: 1.02; letter-spacing: -0.02em; max-width: 18ch; overflow-wrap: break-word; hyphens: manual; }
  .ingress { max-width: 760px; font-size: clamp(18px, 1.7vw, 23px); line-height: 1.5; color: #2e3632; }
  .fakta { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .fakta li { display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px; border-radius: 999px; background: #fff; font-size: 15px; font-weight: 600; }
  .fakta :global(svg) { color: var(--fg); flex-shrink: 0; }

  /* Body */
  .kropp { max-width: 720px; display: flex; flex-direction: column; gap: 32px; padding-block: clamp(32px, 4.5vw, 64px) clamp(40px, 6vw, 96px); }
  .kropp :global(.a-bilde) { aspect-ratio: 16 / 9; height: auto; border-radius: 24px; }
  .brodtekst { padding-bottom: 0; max-width: none; font-size: 19px; line-height: 1.75; color: #2e3632; }
  .vedlegg { background: var(--surface); border-radius: 22px; padding: 8px 24px 4px; }
  .vedlegg h2 { padding: 16px 0 6px; font-family: inherit; font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1.4; color: var(--muted); }
  .vedlegg ul { list-style: none; margin: 0; padding: 0; }
  .del { display: flex; }
  .kopier {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 42px; padding: 0 16px; border-radius: 999px;
    border: 1px solid var(--kant); background: var(--surface); font: inherit; font-size: 15px; font-weight: 600; color: var(--ink); cursor: pointer;
  }
  .kopier:hover { border-color: var(--ink); }

  /* Flere saker */
  .flere { background: var(--sand); padding-block: clamp(36px, 4.5vw, 64px) clamp(44px, 5.5vw, 80px); }
  .flere-topp { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 32px; }
  .flere h2 { font-size: clamp(26px, 2.6vw, 36px); }
  .alle { display: inline-flex; align-items: center; gap: 6px; font-size: 15px; font-weight: 600; color: var(--accent); white-space: nowrap; }
  .alle :global(svg) { transition: transform 0.15s; }
  .alle:hover :global(svg) { transform: translateX(3px); }
  .flere ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; }
  /* White cards: the category tints are too close to the sand band on their own */
  .flere li a { display: flex; flex-direction: column; gap: 14px; height: 100%; padding: 12px 12px 20px; border-radius: 24px; background: var(--surface); color: var(--ink); }
  .flere .f-tekst { padding-inline: 8px; }
  .flere :global(.f-bilde) { height: 180px; border-radius: 20px; }
  .f-tekst { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; min-width: 0; }
  .f-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; font-size: 14px; color: var(--muted); }
  .f-tittel { font-family: var(--serif); font-size: 24px; line-height: 1.15; overflow-wrap: break-word; hyphens: manual; max-width: 100%; }
  .flere li a:hover { color: var(--ink); }
  .flere li a:hover .f-tittel { color: var(--accent); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }

  @media (max-width: 900px) {
    .flere ul { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .flere li a { flex-direction: row; align-items: center; gap: 16px; padding: 10px; border-radius: 20px; }
    .flere .f-tekst { padding-inline: 0 6px; }
    .flere :global(.f-bilde) { width: 84px; height: 84px; flex-shrink: 0; border-radius: 16px; }
    .f-tekst { gap: 6px; }
    .f-meta { font-size: 12px; }
    .f-tittel { font-size: 19px; line-height: 1.2; }
  }
  @media (max-width: 640px) {
    .hode :global(.hode-hus) { width: 220px; height: 150px; right: -28px; bottom: -24px; }
    .hode-innhold { gap: 14px; }
    .tilbake { font-size: 14px; }
    .meta { font-size: 13px; }
    .hode h1 { line-height: 1.08; }
    .ingress { line-height: 1.55; }
    .fakta li { padding: 7px 12px; font-size: 14px; }
    .kropp { gap: 24px; }
    .kropp :global(.a-bilde) { border-radius: 20px; }
    .brodtekst { font-size: 17px; line-height: 1.7; }
    .vedlegg { border-radius: 18px; padding: 6px 16px; }
    .vedlegg h2 { font-size: 12px; padding: 12px 0 4px; }
    .del, .kopier { align-self: stretch; }
    .kopier { height: 46px; width: 100%; }
  }
</style>
