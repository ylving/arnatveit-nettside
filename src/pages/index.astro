---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import InfoCards from '../components/InfoCards.astro';
import Illustrasjon from '../components/Illustrasjon.astro';
import Faktabaand from '../components/Faktabaand.astro';
import TogKort from '../components/TogKort.astro';
import ForsideAktuelt from '../components/ForsideAktuelt.astro';
import ForsideNaa from '../components/ForsideNaa.astro';
import { load, urlFor } from '../lib/sanity';
import { ABC_UTGAVE, DOC_REF, DOC_REF_FIELDS, DOKUMENT, LINK, NYHET_KORT, SIDE_KORT } from '../lib/queries';
import { ARRANGEMENTER } from '../lib/arrangement';
import { docHref, linkHref, oppgaveAnker } from '../lib/urls';

const data = await load<any>(`{
  "forside": *[_id == "forside"][0]{
    ..., "knapper": knapper[]${LINK},
    seksjoner[]{
      ...,
      // Shortcuts: a task ("Jeg vil …") links to its steps on the page that has it, a document to its PDF
      _type == "forsideDokumentsenter" => { "lenke": lenke${LINK}, "dokumenter": dokumenter[]->{
        _type,
        _type == "oppgave" => { _id, tittel, "side": *[_type == "side" && ^._id in seksjoner[].oppgaver[]._ref][0]${DOC_REF} },
        _type != "oppgave" => ${DOKUMENT}
      } }
    }
  },
  // Aktuelt: the newest, plus the newest pinned one (it takes the featured slot even when it's older)
  "nyheter": *[_type == "nyhet" && defined(slug.current)] | order(dato desc, _createdAt desc)[0...4]${NYHET_KORT},
  "festet": *[_type == "nyhet" && defined(slug.current) && festet == true] | order(dato desc, _createdAt desc)[0]${NYHET_KORT},
  "arrangementer": ${ARRANGEMENTER},
  "abc": *[_type == "abcUtgave" && defined(fil.asset)] | order(aar desc, maaned desc)[0]${ABC_UTGAVE},
  "dugnadSide": *[_id == "side-dugnad"][0]${DOC_REF},
  "praktisk": *[_type == "side" && forelder._ref == "side-praktisk-info"] | order(rekkefolge asc)${SIDE_KORT},
  "abcSide": *[_id == "side-abc-nytt"][0]${DOC_REF},
  "piSide": *[_id == "side-praktisk-info"][0]{ ingress, ${DOC_REF_FIELDS} }
}`);
const { forside: f, abc, praktisk, abcSide, piSide, arrangementer, dugnadSide } = data;
// The pinned post first (if it's not among the newest four already), so fremhevet() picks it
const nyheter = data.festet && !data.nyheter.some((n: any) => n._id === data.festet._id) ? [data.festet, ...data.nyheter] : data.nyheter;
// Hero image cropped to the illustration's 14:11 frame (hotspot decides the crop)
const heroSrc = (w: number) => urlFor(f.bilde).width(w).height(Math.round((w * 11) / 14)).fit('crop').url();
---
<Base description={f.seo?.beskrivelse}>
  <section class="container hero">
    <div class="hero-text">
      {f.overtittel && <div class="eyebrow">{f.overtittel}</div>}
      <h1>{f.tittel}</h1>
      {f.ingress && <p class="lead">{f.ingress}</p>}
      <div class="actions">
        {f.knapper?.map((k: any, i: number) => (
          <a class={i === 0 ? 'btn btn--primary' : 'btn'} href={linkHref(k)}>{k.tekst}{i === 0 && <Icon name="ArrowRight" size={18} />}</a>
        ))}
      </div>
    </div>
    <div class="hero-art">
      {f.bilde?.asset ? (
        <img
          class="hero-img"
          src={heroSrc(1120)}
          srcset={[560, 840, 1120, 1680].map((w) => `${heroSrc(w)} ${w}w`).join(', ')}
          sizes="(max-width: 960px) calc(100vw - 2 * var(--gutter)), 560px"
          width="560"
          height="440"
          alt={f.bilde.alt ?? ''}
          fetchpriority="high"
        />
      ) : (
        <Illustrasjon />
      )}
      <TogKort />
    </div>
  </section>

  {/* The editor's sections in their order; each type at most once (validated in the Studio) */}
  {(f.seksjoner ?? []).map((s: any) => (
    <div class={`fs fs--${s._type}`}>
      {s._type === 'forsideFakta' && <Faktabaand seksjon={s} fakta={s.fakta} />}
      {s._type === 'forsideAktuelt' && <ForsideAktuelt nyheter={nyheter} tittel={s.tittel || undefined} />}
      {s._type === 'forsideNaa' && <ForsideNaa arrangementer={arrangementer} abc={abc} dugnadSide={dugnadSide} abcSide={abcSide} tittel={s.tittel || undefined} />}
      {s._type === 'forsidePraktisk' && (
        <section class="container block">
          <div class="section-head">
            <h2 class="section-title"><a href={docHref(piSide)}>{s.tittel || 'Praktisk info'}</a></h2>
            {(s.ingress || piSide?.ingress) && <p>{s.ingress || piSide.ingress}</p>}
          </div>
          <InfoCards sider={praktisk} />
        </section>
      )}
      {s._type === 'forsideDokumentsenter' && s.tittel && (
        <section class="container block">
          <div class="docs">
            <div class="docs-text">
              <span class="kicker">Dokumentsenter</span>
              <h2>{s.tittel}</h2>
              {s.tekst && <p>{s.tekst}</p>}
              {s.lenke && <a class="btn btn--dark" href={linkHref(s.lenke)}>{s.lenke.tekst}</a>}
            </div>
            {s.dokumenter?.length > 0 && (
              <ul class="doc-links">
                {s.dokumenter.filter(Boolean).map((d: any) => d._type === 'oppgave'
                  ? d.side && <li><a href={`${docHref(d.side)}#${oppgaveAnker(d._id)}`}>{d.tittel}<Icon name="ArrowRight" size={20} /></a></li>
                  : <li><a href={d.url} target="_blank">{d.tittel}<Icon name="ArrowRight" size={20} /></a></li>)}
              </ul>
            )}
          </div>
        </section>
      )}
    </div>
  ))}
</Base>

<style>
  .hero { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(40px, 5vw, 72px); align-items: center; padding-block: clamp(36px, 6vw, 80px) clamp(28px, 4vw, 64px); }
  .hero-text { display: flex; flex-direction: column; gap: 28px; }
  .eyebrow { font-size: 14px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  h1 { font-size: clamp(38px, 5vw, 68px); line-height: 1.04; letter-spacing: -0.02em; }
  .lead { margin: 0; font-size: clamp(17px, 1.4vw, 19px); color: var(--ink-2); max-width: 520px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-art { position: relative; }
  .hero-img { width: 100%; height: auto; aspect-ratio: 14 / 11; object-fit: cover; border-radius: var(--radius-lg); background: var(--accent-soft); }

  .block { padding-top: clamp(56px, 7vw, 96px); }
  /* Spacing for any order: whichever section comes first sits 32px under the hero (its own bottom padding does the
     rest); further down they all get the full gap. The last one keeps space above the footer. */
  .hero + .fs > :global(:is(.baand, .naa)) { margin-top: 32px; }
  .hero + .fs > :global(section:not(.baand, .naa)) { padding-top: 32px; }
  .fs--forsideFakta:not(.hero + .fs) > :global(.baand) { margin-top: clamp(56px, 7vw, 96px); }
  .fs:last-child { padding-bottom: clamp(56px, 8vw, 112px); }
  .section-title { font-size: clamp(30px, 3.4vw, 44px); margin-bottom: 32px; }
  .section-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 32px; }
  .section-head .section-title { margin: 0; }
  .section-head p { margin: 0; font-size: 17px; color: var(--muted); max-width: 420px; text-align: right; }

  .docs { background: var(--sand); border-radius: 32px; padding: clamp(26px, 4.5vw, 56px); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(28px, 4.5vw, 56px); align-items: center; }
  .docs-text { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .docs h2 { font-size: clamp(26px, 3vw, 40px); line-height: 1.12; }
  .docs p { margin: 0; color: var(--ink-2); }
  .doc-links { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .doc-links a { background: var(--surface); border-radius: 18px; padding: 20px 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; font-weight: 600; font-size: 17px; line-height: 1.3; }

  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; }
    .hero-art { max-width: 560px; }
    .docs { grid-template-columns: 1fr; }
    .section-head { flex-direction: column; align-items: flex-start; }
    .section-head p { text-align: left; }
  }
  @media (max-width: 640px) {
    .actions .btn { flex: 1 1 100%; }
  }
</style>
