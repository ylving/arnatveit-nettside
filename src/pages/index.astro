---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import InfoCards from '../components/InfoCards.astro';
import Illustrasjon from '../components/Illustrasjon.astro';
import Faktabaand from '../components/Faktabaand.astro';
import { load, urlFor } from '../lib/sanity';
import { DOC_REF, DOC_REF_FIELDS, DOKUMENT, LINK, SIDE_KORT } from '../lib/queries';
import { docHref, linkHref } from '../lib/urls';
import { utgaveNavn } from '../../sanity/standarder';

const data = await load<any>(`{
  "forside": *[_id == "forside"][0]{
    ..., "knapper": knapper[]${LINK}, snarvei{ ..., "lenke": lenke${LINK} },
    dokumentsenter{ ..., "lenke": lenke${LINK}, "dokumenter": dokumenter[]->${DOKUMENT} }
  },
  "nyhet": *[_type == "nyhet"] | order(fremhevet desc, dato desc)[0]{ tittel, merkelapp, ingress, "slug": slug.current, _type, "dokumenter": dokumenter[]->${DOKUMENT} },
  "abc": *[_type == "abcUtgave" && defined(fil.asset)] | order(aar desc, maaned desc)[0]{ maaned, aar, "url": fil.asset->url },
  "praktisk": *[_type == "side" && forelder._ref == "side-praktisk-info"] | order(rekkefolge asc)${SIDE_KORT},
  "gf": *[_id == "side-generalforsamling"][0]${DOC_REF},
  "abcSide": *[_id == "side-abc-nytt"][0]${DOC_REF},
  "piSide": *[_id == "side-praktisk-info"][0]{ ingress, ${DOC_REF_FIELDS} }
}`);
const { forside: f, nyhet, abc, praktisk, gf, abcSide, piSide } = data;
const pdf = nyhet?.dokumenter?.[0];
const abcMonth = abc && utgaveNavn(abc.maaned, abc.aar).toLowerCase();
// Hero image cropped to the illustration's 14:11 frame (hotspot decides the crop)
const heroSrc = (w: number) => urlFor(f.bilde).width(w).height(Math.round((w * 11) / 14)).fit('crop').url();
---
<Base description={f.seo?.beskrivelse}>
  <section class="container hero">
    <div class="hero-text">
      {f.overtittel && <div class="eyebrow">{f.overtittel}</div>}
      <h1>{f.tittel}</h1>
      {f.ingress && <p class="lead">{f.ingress}</p>}
      <div class="actions">
        {f.knapper?.map((k: any, i: number) => (
          <a class={i === 0 ? 'btn btn--primary' : 'btn'} href={linkHref(k)}>{k.tekst}{i === 0 && <Icon name="ArrowRight" size={18} />}</a>
        ))}
      </div>
    </div>
    <div class="hero-art">
      {f.bilde?.asset ? (
        <img
          class="hero-img"
          src={heroSrc(1120)}
          srcset={[560, 840, 1120, 1680].map((w) => `${heroSrc(w)} ${w}w`).join(', ')}
          sizes="(max-width: 960px) calc(100vw - 2 * var(--gutter)), 560px"
          width="560"
          height="440"
          alt={f.bilde.alt ?? ''}
          fetchpriority="high"
        />
      ) : (
        <Illustrasjon />
      )}
      {f.infokort?.tittel && (
        <div class="float">
          <span class="ic"><Icon name="TrainFront" size={22} /></span>
          <span><strong>{f.infokort.tittel}</strong><span>{f.infokort.tekst}</span></span>
        </div>
      )}
    </div>
  </section>

  <Faktabaand seksjon={f.faktaseksjon} fakta={f.fakta} />

  <section class="container block">
    <h2 class="section-title">Aktuelt</h2>
    <div class="news">
      {nyhet && (
        <article class="featured">
          <div>
            {nyhet.merkelapp && <span class="tag">{nyhet.merkelapp}</span>}
            <h3><a href={docHref(nyhet)}>{nyhet.tittel}</a></h3>
            <p>{nyhet.ingress}</p>
          </div>
          <div class="actions">
            {pdf && <a class="btn" href={pdf.url} target="_blank"><Icon name="File" size={18} />Les protokollen (PDF)</a>}
            {gf && <a class="btn btn--outline-light" href={docHref(gf)}>Alle generalforsamlinger</a>}
          </div>
        </article>
      )}
      <div class="side-cards">
        {abc && (
          <article class="card">
            <span class="kicker">ABC-nytt</span>
            <h3>Siste utgave: {abcMonth}</h3>
            <p>Borettslagets informasjonsorgan, ca. seks ganger i året.</p>
            <a class="text-link" href={abc.url} target="_blank">Les ABC-nytt</a>
            {abcSide && <a class="more" href={docHref(abcSide)}>Alle utgaver</a>}
          </article>
        )}
        {f.snarvei?.tittel && (
          <article class="card">
            {f.snarvei.merkelapp && <span class="kicker">{f.snarvei.merkelapp}</span>}
            <h3>{f.snarvei.tittel}</h3>
            {f.snarvei.lenke && <a class="text-link" href={linkHref(f.snarvei.lenke)}>{f.snarvei.lenke.tekst}</a>}
          </article>
        )}
      </div>
    </div>
  </section>

  <section class="container block">
    <div class="section-head">
      <h2 class="section-title"><a href={docHref(piSide)}>Praktisk info</a></h2>
      {piSide?.ingress && <p>{piSide.ingress}</p>}
    </div>
    <InfoCards sider={praktisk} />
  </section>

  {f.dokumentsenter?.tittel && (
    <section class="container block last">
      <div class="docs">
        <div class="docs-text">
          <span class="kicker">Dokumentsenter</span>
          <h2>{f.dokumentsenter.tittel}</h2>
          {f.dokumentsenter.tekst && <p>{f.dokumentsenter.tekst}</p>}
          {f.dokumentsenter.lenke && <a class="btn btn--dark" href={linkHref(f.dokumentsenter.lenke)}>{f.dokumentsenter.lenke.tekst}</a>}
        </div>
        {f.dokumentsenter.dokumenter?.length > 0 && (
          <ul class="doc-links">
            {f.dokumentsenter.dokumenter.map((d: any) => <li><a href={d.url} target="_blank">{d.tittel}<Icon name="ArrowRight" size={20} /></a></li>)}
          </ul>
        )}
      </div>
    </section>
  )}
</Base>

<style>
  .hero { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(40px, 5vw, 72px); align-items: center; padding-block: clamp(36px, 6vw, 80px) clamp(28px, 4vw, 64px); }
  .hero-text { display: flex; flex-direction: column; gap: 28px; }
  .eyebrow { font-size: 14px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  h1 { font-size: clamp(38px, 5vw, 68px); line-height: 1.04; letter-spacing: -0.02em; }
  .lead { margin: 0; font-size: clamp(17px, 1.4vw, 19px); color: var(--ink-2); max-width: 520px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-art { position: relative; }
  .hero-img { width: 100%; height: auto; aspect-ratio: 14 / 11; object-fit: cover; border-radius: var(--radius-lg); background: var(--accent-soft); }
  .float { position: absolute; left: -32px; bottom: -28px; background: var(--surface); border-radius: 18px; padding: 18px 22px; display: flex; align-items: center; gap: 14px; box-shadow: 0 12px 32px rgba(29, 36, 32, 0.12); }
  .float .ic { width: 44px; height: 44px; border-radius: 12px; background: var(--accent-soft); color: var(--accent); display: grid; place-items: center; }
  .float strong { display: block; font-size: 16px; }
  .float strong + span { font-size: 14px; color: var(--muted); }


  .block { padding-top: clamp(56px, 7vw, 96px); }
  .block.last { padding-bottom: clamp(56px, 8vw, 112px); }
  .section-title { font-size: clamp(30px, 3.4vw, 44px); margin-bottom: 32px; }
  .section-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 32px; }
  .section-head .section-title { margin: 0; }
  .section-head p { margin: 0; font-size: 17px; color: var(--muted); max-width: 420px; text-align: right; }

  .news { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .featured { grid-column: span 2; background: var(--accent); color: #fff; border-radius: 28px; padding: clamp(26px, 3.5vw, 44px); display: flex; flex-direction: column; justify-content: space-between; gap: 40px; min-height: 300px; }
  .featured .tag { font-size: 14px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-on); }
  .featured h3 { font-size: clamp(26px, 3vw, 40px); margin: 14px 0; }
  .featured h3 a:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
  .featured p { margin: 0; color: #e8f0ea; max-width: 560px; }
  .featured .btn { border-color: #fff; }
  .btn--outline-light { background: transparent; border: 1.5px solid #fff; color: #fff; }
  .btn--outline-light:hover { color: #fff; background: rgba(255, 255, 255, 0.1); border-color: #fff; }
  .side-cards { display: flex; flex-direction: column; gap: 24px; }
  .card { flex: 1; background: var(--surface); border: 1px solid var(--line); border-radius: 24px; padding: 28px; display: flex; flex-direction: column; gap: 10px; }
  .card h3 { font-size: clamp(22px, 2vw, 26px); }
  .card p { margin: 0; font-size: 15px; line-height: 1.55; color: var(--muted); }
  .card .text-link { margin-top: auto; font-size: 15px; }
  .card .more { font-size: 14px; color: var(--muted); }

  .docs { background: var(--sand); border-radius: 32px; padding: clamp(26px, 4.5vw, 56px); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(28px, 4.5vw, 56px); align-items: center; }
  .docs-text { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .docs h2 { font-size: clamp(26px, 3vw, 40px); line-height: 1.12; }
  .docs p { margin: 0; color: var(--ink-2); }
  .doc-links { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .doc-links a { background: var(--surface); border-radius: 18px; padding: 20px 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; font-weight: 600; font-size: 17px; line-height: 1.3; }

  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; }
    .hero-art { max-width: 560px; }
    .float { left: 16px; bottom: -24px; }
    .news { grid-template-columns: 1fr; }
    .featured { grid-column: auto; min-height: 0; }
    .docs { grid-template-columns: 1fr; }
    .section-head { flex-direction: column; align-items: flex-start; }
    .section-head p { text-align: left; }
  }
  @media (max-width: 640px) {
    .actions .btn { flex: 1 1 100%; }
    .float { position: static; margin-top: 12px; box-shadow: none; border: 1px solid var(--line); }
  }
</style>
