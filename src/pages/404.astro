---
import Base from '../layouts/Base.astro';
import { load } from '../lib/sanity';
import { DOC_REF } from '../lib/queries';
import { docHref } from '../lib/urls';

const dokumentsenter = await load<any>(`*[_id == "side-dokumentsenter"][0]${DOC_REF}`);
---
<Base title="Fant ikke siden">
  <div class="container">
    <header class="page-head">
      <h1>Fant ikke siden</h1>
      <p class="ingress">Siden du leter etter finnes ikke, eller har fått ny adresse etter at nettsiden ble fornyet.</p>
      <p style="margin-top: 28px; display: flex; gap: 12px; flex-wrap: wrap"><a class="btn btn--primary" href="/">Til forsiden</a>{dokumentsenter && <a class="btn" href={docHref(dokumentsenter)}>Dokumentsenter</a>}</p>
    </header>
  </div>
</Base>
