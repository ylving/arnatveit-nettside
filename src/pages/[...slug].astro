---
import Base from '../layouts/Base.astro';
import Seksjoner from '../components/Seksjoner.astro';
import Brodsmuler from '../components/Brodsmuler.astro';
import Kontaktboks from '../components/Kontaktboks.astro';
import { load } from '../lib/sanity';
import { KONTAKT, SIDE, SIDE_PATHS } from '../lib/queries';

export async function getStaticPaths() {
  const sider = await load<{ slug: string; forelder: string | null }[]>(SIDE_PATHS);
  return sider.map(({ slug, forelder }) => ({
    params: { slug: forelder ? `${forelder}/${slug}` : slug },
    props: { slug },
  }));
}

const { slug } = Astro.props;
const [side, kontakt] = await Promise.all([load<any>(SIDE, { slug }), load<any>(KONTAKT)]);
// Contact box beside the title: its own email, or the board's from Innstillinger
const k = side.kontaktboks;
const boks = k && (k.tittel || k.epost) ? { tittel: k.tittel || undefined, epost: k.epost || kontakt?.epost } : null;
---
<Base title={side.seo?.tittel ?? side.tittel} description={side.seo?.beskrivelse ?? side.ingress}>
  <div class="container">
    <header class:list={['page-head', { 'med-boks': boks }]}>
      <div>
        {side.forelder && <Brodsmuler forelder={{ tittel: side.forelder.tittel, href: `/${side.forelder.slug}` }} gjeldende={side.tittel} />}
        <h1>{side.tittel}</h1>
        {side.ingress && <p class="ingress">{side.ingress}</p>}
      </div>
      {boks && <Kontaktboks {...boks} />}
    </header>
  </div>
  <Seksjoner seksjoner={side.seksjoner} kontakt={kontakt} barn={side.barn} />
</Base>
