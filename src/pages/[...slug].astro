---
import Base from '../layouts/Base.astro';
import Innhold from '../components/portable/Innhold.astro';
import InfoCards from '../components/InfoCards.astro';
import { load } from '../lib/sanity';
import { SIDE, SIDE_PATHS } from '../lib/queries';

export async function getStaticPaths() {
  const sider = await load<{ slug: string; forelder: string | null }[]>(SIDE_PATHS);
  return sider.map(({ slug, forelder }) => ({
    params: { slug: forelder ? `${forelder}/${slug}` : slug },
    props: { slug },
  }));
}

const { slug } = Astro.props;
const [side, kontakt] = await Promise.all([load<any>(SIDE, { slug }), load<any>(`*[_id == "innstillinger"][0].kontakt`)]);
---
<Base title={side.seo?.tittel ?? side.tittel} description={side.seo?.beskrivelse ?? side.ingress}>
  <div class="container">
    <header class="page-head">
      {side.forelder && <nav class="breadcrumb" aria-label="Brødsmuler"><a href={`/${side.forelder.slug}`}>{side.forelder.tittel}</a></nav>}
      <h1>{side.tittel}</h1>
      {side.ingress && <p class="ingress">{side.ingress}</p>}
    </header>
    {side.barn?.length > 0 && <div class="children"><InfoCards sider={side.barn} /></div>}
    {side.innhold?.length > 0 && <div class="prose"><Innhold value={side.innhold} kontakt={kontakt} /></div>}
  </div>
</Base>
<style>
  .children { padding-bottom: clamp(56px, 8vw, 112px); }
</style>
