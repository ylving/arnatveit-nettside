---
import Base from '../layouts/Base.astro';
import Seksjoner from '../components/Seksjoner.astro';
import Brodsmuler from '../components/Brodsmuler.astro';
import Kontaktboks from '../components/Kontaktboks.astro';
import AbcSiste from '../components/AbcSiste.astro';
import { load } from '../lib/sanity';
import Icon from '../components/Icon.astro';
import { KONTAKT, SIDE, SIDE_PATHS } from '../lib/queries';
import { seksjonAnker } from '../lib/urls';

export async function getStaticPaths() {
  const sider = await load<{ slug: string; forelder: string | null }[]>(SIDE_PATHS);
  return sider.map(({ slug, forelder }) => ({
    params: { slug: forelder ? `${forelder}/${slug}` : slug },
    props: { slug },
  }));
}

const { slug } = Astro.props;
const [side, kontakt] = await Promise.all([load<any>(SIDE, { slug }), load<any>(KONTAKT)]);
// Contact box beside the title: its own email, or the board's from «Om borettslaget»
const k = side.kontaktboks;
const boks = k && (k.tittel || k.epost) ? { tittel: k.tittel || undefined, epost: k.epost || kontakt?.epost } : null;
// Pages with an ABC-nytt section show the newest issue beside the title
const abcSiste = side.seksjoner?.find((s: any) => s._type === 'abcUtgaver')?.utgaver?.[0];
// "Vis snarveier øverst": pill links to the sections that have an anchor (Kontakt, Området, Fakta …)
const snarveier = side.snarveier ? (side.seksjoner ?? []).map(seksjonAnker).filter(Boolean) : [];
---
<Base title={side.seo?.tittel ?? side.tittel} description={side.seo?.beskrivelse ?? side.ingress}>
  <div class="container">
    <header class:list={['page-head', { 'med-boks': boks, 'med-abc': abcSiste }]}>
      <div>
        {side.forelder && <Brodsmuler forelder={{ tittel: side.forelder.tittel, href: `/${side.forelder.slug}` }} gjeldende={side.tittel} />}
        <h1>{side.tittel}</h1>
        {side.ingress && <p class="ingress">{side.ingress}</p>}
        {snarveier.length > 0 && (
          <nav class="snarveier" aria-label="På denne siden">
            {snarveier.map((a: any) => <a href={`#${a.id}`}>{a.tekst}<Icon name="ArrowDown" size={16} /></a>)}
          </nav>
        )}
      </div>
      {boks && <Kontaktboks {...boks} />}
      {abcSiste && <AbcSiste utgave={abcSiste} />}
    </header>
  </div>
  <Seksjoner seksjoner={side.seksjoner} kontakt={kontakt} barn={side.barn} />
</Base>
