---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Banner from '../components/Banner.astro';
import Footer from '../components/Footer.astro';
import { load } from '../lib/sanity';
import { INNSTILLINGER } from '../lib/queries';

interface Props { title?: string; description?: string }
const innstillinger = await load<any>(INNSTILLINGER);
const { title, description = innstillinger?.beskrivelse } = Astro.props;
const fullTitle = title ? `${title} – ${innstillinger.navn}` : innstillinger.navn;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:locale" content="nb_NO" />
    <meta name="theme-color" content="#2F5D4E" />
  </head>
  <body>
    <a class="visually-hidden skip" href="#innhold">Hopp til innhold</a>
    <Header navn={innstillinger.navn} meny={innstillinger.hovedmeny} />
    {innstillinger.banner?.aktiv && <Banner {...innstillinger.banner} />}
    <main id="innhold"><slot /></main>
    <Footer innstillinger={innstillinger} />
  </body>
</html>
<style is:global>
  .skip:focus { position: fixed; top: 12px; left: 12px; width: auto; height: auto; clip: auto; padding: 10px 16px; background: var(--ink); color: #fff; border-radius: 8px; z-index: 100; }
</style>
